{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "predict-comparison-slate-1.schema.json",
  "title": "One saved upcoming NFL slate",
  "type": "object",
  "required": [
    "version",
    "view",
    "filter",
    "policy",
    "games",
    "boards",
    "errors",
    "stopped",
    "as_of",
    "bounds",
    "provider_requests"
  ],
  "properties": {
    "version": {
      "const": "predict-comparison-slate-1"
    },
    "view": {
      "enum": [
        "odds",
        "ev",
        "arbs"
      ]
    },
    "filter": {
      "enum": [
        "positive",
        "all",
        "hedges"
      ]
    },
    "policy": {
      "type": "object"
    },
    "games": {
      "$ref": "predict-board-catalog-1.schema.json#/properties/games"
    },
    "boards": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "predict-comparison-board-1.schema.json"
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "game_key",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "game_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "reason": {
            "const": "game_inputs_unavailable"
          }
        }
      }
    },
    "stopped": {
      "type": "boolean"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "bounds": {
      "type": "object",
      "required": [
        "maximum_games",
        "maximum_bytes"
      ],
      "properties": {
        "maximum_games": {
          "const": 200
        },
        "maximum_bytes": {
          "const": 8388608
        }
      }
    },
    "provider_requests": {
      "const": 0
    },
    "storage": {
      "type": "object"
    }
  }
}
