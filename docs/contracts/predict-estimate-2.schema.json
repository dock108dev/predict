{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "predict-estimate-2.schema.json",
  "title": "S01 generic requested policy and fixed estimate contracts",
  "description": "Semantic funding, provenance, scope, partition, arithmetic and revision validation is authoritative in app/comparison/estimated_policy.py. Financial values are exact strings.",
  "oneOf": [
    {
      "$ref": "#/$defs/policy"
    },
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/result"
    }
  ],
  "$defs": {
    "policy": {
      "type": "object",
      "required": [
        "version",
        "capital_ceiling_usd",
        "buffer_rate",
        "tie",
        "terminal_noncompletion",
        "revision",
        "execution_role",
        "execution_channel",
        "portfolio_basis",
        "funding_basis",
        "holding_period",
        "denominator",
        "funding_components",
        "buffer",
        "probability_defaults",
        "size_statuses",
        "input_bases",
        "input_version",
        "result_version",
        "legacy_sensitivity",
        "buffer_applied_to_existing_metrics",
        "sizing_mode",
        "benchmark_venue",
        "benchmark_method",
        "requested_amount_usd"
      ],
      "properties": {
        "version": {
          "const": "predict-estimate-policy-3"
        },
        "capital_ceiling_usd": {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$"
        },
        "buffer_rate": {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$"
        },
        "tie": {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$"
        },
        "terminal_noncompletion": {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "execution_role": {
          "const": "taker"
        },
        "execution_channel": {
          "const": "direct_site"
        },
        "portfolio_basis": {
          "const": "standalone"
        },
        "funding_basis": {
          "const": "already_funded"
        },
        "holding_period": {
          "const": "to_settlement"
        },
        "denominator": {
          "const": "actual_deployed_capital"
        },
        "funding_components": {
          "const": [
            "acquisition_or_stake",
            "unavoidable_upfront_fees",
            "independent_funded_collateral"
          ]
        },
        "buffer": {
          "type": "object",
          "required": [
            "rate",
            "basis",
            "treatment",
            "applications_per_opportunity",
            "consumes_funding"
          ],
          "properties": {
            "rate": {
              "type": "string",
              "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$"
            },
            "basis": {
              "const": "actual_deployed_capital"
            },
            "treatment": {
              "const": "model_haircut"
            },
            "applications_per_opportunity": {
              "const": 1
            },
            "consumes_funding": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "probability_defaults": {
          "type": "object",
          "required": [
            "scope",
            "basis",
            "measured_rate",
            "states",
            "tie",
            "terminal_noncompletion"
          ],
          "properties": {
            "scope": {
              "const": [
                "NFL",
                "regular_season",
                "pregame",
                "full_game",
                "winner",
                "including_overtime"
              ]
            },
            "basis": {
              "const": "provisional_prior"
            },
            "measured_rate": {
              "const": false
            },
            "states": {
              "const": [
                "a_wins",
                "b_wins",
                "tie",
                "terminal_noncompletion"
              ]
            },
            "tie": {
              "type": "object",
              "required": [
                "central",
                "low",
                "high"
              ],
              "properties": {
                "central": {
                  "type": "string",
                  "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$"
                },
                "low": {
                  "const": "0"
                },
                "high": {
                  "const": "0.01"
                }
              },
              "additionalProperties": false
            },
            "terminal_noncompletion": {
              "type": "object",
              "required": [
                "central",
                "low",
                "high"
              ],
              "properties": {
                "central": {
                  "type": "string",
                  "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$"
                },
                "low": {
                  "const": "0"
                },
                "high": {
                  "const": "0.005"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "size_statuses": {
          "const": [
            "supported_size",
            "modeled_size",
            "size_unverified"
          ]
        },
        "input_bases": {
          "const": [
            "observed_fact",
            "published_template",
            "provisional_assumption",
            "unknown_actual"
          ]
        },
        "input_version": {
          "const": "predict-estimate-input-1"
        },
        "result_version": {
          "const": "predict-estimate-result-2"
        },
        "legacy_sensitivity": {
          "const": "adverse_price_stress"
        },
        "buffer_applied_to_existing_metrics": {
          "const": false
        },
        "sizing_mode": {
          "enum": [
            "requested_trade",
            "ceiling"
          ]
        },
        "benchmark_venue": {
          "enum": [
            "pinnacle",
            "novig",
            "prophetx"
          ]
        },
        "benchmark_method": {
          "const": "proportional_no_vig"
        },
        "requested_amount_usd": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$",
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": [
        "provider_kind",
        "provider_version",
        "basis",
        "scope_id",
        "actual_value",
        "modeled_value",
        "version"
      ],
      "properties": {
        "provider_kind": {
          "enum": [
            "fee",
            "payout",
            "probability",
            "liquidity"
          ]
        },
        "provider_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "basis": {
          "enum": [
            "observed_fact",
            "published_template",
            "provisional_assumption",
            "unknown_actual"
          ]
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actual_value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "modeled_value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "const": "predict-estimate-input-1"
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "version",
        "policy_version",
        "policy_revision",
        "target_ceiling_usd",
        "deployed_capital_usd",
        "unused_cash_usd",
        "fee_adjusted_expected_profit_usd",
        "unbuffered_return_percent",
        "buffer_usd",
        "buffer_treatment",
        "buffered_profit_usd",
        "buffered_return_percent",
        "conditioning",
        "size_status",
        "supported_capital_usd",
        "inputs",
        "revision",
        "sizing_mode",
        "benchmark_venue",
        "benchmark_method",
        "requested_amount_usd"
      ],
      "properties": {
        "version": {
          "const": "predict-estimate-result-2"
        },
        "policy_version": {
          "const": "predict-estimate-policy-3"
        },
        "policy_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target_ceiling_usd": {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$"
        },
        "deployed_capital_usd": {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$"
        },
        "unused_cash_usd": {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$"
        },
        "fee_adjusted_expected_profit_usd": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unbuffered_return_percent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "buffer_usd": {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$"
        },
        "buffer_treatment": {
          "const": "model_haircut"
        },
        "buffered_profit_usd": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "buffered_return_percent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "conditioning": {
          "enum": [
            "modeled_complete",
            "modeled_conditional",
            "unavailable"
          ]
        },
        "size_status": {
          "enum": [
            "supported_size",
            "modeled_size",
            "size_unverified"
          ]
        },
        "supported_capital_usd": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputs": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/input"
          }
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sizing_mode": {
          "enum": [
            "requested_trade",
            "ceiling"
          ]
        },
        "benchmark_venue": {
          "enum": [
            "pinnacle",
            "novig",
            "prophetx"
          ]
        },
        "benchmark_method": {
          "const": "proportional_no_vig"
        },
        "requested_amount_usd": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$",
          "maxLength": 256
        }
      },
      "additionalProperties": false
    }
  }
}
