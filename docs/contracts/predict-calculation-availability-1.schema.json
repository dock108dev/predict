{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "predict-calculation-availability-1.schema.json",
  "type": "object",
  "required": [
    "version",
    "state",
    "reason_codes",
    "metrics",
    "numeric_metrics",
    "current_opportunity_eligible"
  ],
  "properties": {
    "version": {
      "const": "predict-calculation-availability-1"
    },
    "state": {
      "enum": [
        "numeric_current",
        "numeric_last_known",
        "missing_reference",
        "unsupported_inputs",
        "calculation_failed",
        "not_evaluated"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160
      },
      "maxItems": 64,
      "uniqueItems": true
    },
    "numeric_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 4
    },
    "metrics": {
      "type": "object",
      "maxProperties": 4,
      "additionalProperties": {
        "type": "object",
        "required": [
          "state",
          "reason_codes"
        ],
        "properties": {
          "state": {
            "enum": [
              "numeric_current",
              "numeric_last_known",
              "missing_reference",
              "unsupported_inputs",
              "calculation_failed",
              "not_evaluated"
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 160
            },
            "maxItems": 64,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "current_opportunity_eligible": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "summary": {
      "type": "object",
      "required": [
        "version",
        "scope",
        "games",
        "total_results",
        "numeric_results",
        "current_results",
        "positive_results",
        "counts",
        "outcome",
        "causes"
      ],
      "properties": {
        "version": {
          "const": "predict-calculation-availability-1"
        },
        "scope": {
          "const": "evaluated_results_before_filter"
        },
        "games": {
          "type": "integer",
          "minimum": 0
        },
        "total_results": {
          "type": "integer",
          "minimum": 0
        },
        "numeric_results": {
          "type": "integer",
          "minimum": 0
        },
        "current_results": {
          "type": "integer",
          "minimum": 0
        },
        "positive_results": {
          "type": "integer",
          "minimum": 0
        },
        "counts": {
          "type": "object",
          "required": [
            "numeric_current",
            "numeric_last_known",
            "missing_reference",
            "unsupported_inputs",
            "calculation_failed",
            "not_evaluated"
          ],
          "properties": {
            "numeric_current": {
              "type": "integer",
              "minimum": 0
            },
            "numeric_last_known": {
              "type": "integer",
              "minimum": 0
            },
            "missing_reference": {
              "type": "integer",
              "minimum": 0
            },
            "unsupported_inputs": {
              "type": "integer",
              "minimum": 0
            },
            "calculation_failed": {
              "type": "integer",
              "minimum": 0
            },
            "not_evaluated": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "outcome": {
          "enum": [
            "not_evaluated",
            "unavailable",
            "partial",
            "last_known_only",
            "evaluated_no_positive",
            "positive"
          ]
        },
        "causes": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "code",
              "affected_results",
              "affected_games",
              "venues"
            ],
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 160
              },
              "affected_results": {
                "type": "integer",
                "minimum": 0
              },
              "affected_games": {
                "type": "integer",
                "minimum": 0
              },
              "venues": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 4
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "evaluation_frame": {
      "type": "object",
      "required": [
        "version",
        "evaluated_at",
        "policy",
        "simultaneous_historical_trade",
        "mixed_source_times",
        "quotes",
        "reference_originals"
      ],
      "properties": {
        "version": {
          "const": "predict-last-known-frame-1"
        },
        "evaluated_at": {
          "type": "string"
        },
        "policy": {
          "const": "captured_prices_current_applicability"
        },
        "simultaneous_historical_trade": {
          "const": false
        },
        "mixed_source_times": {
          "type": "boolean"
        },
        "quotes": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object"
          }
        },
        "reference_originals": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object"
          }
        },
        "captured_at": {
          "type": "string"
        },
        "reference_age_seconds": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
