{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "predict-comparison-slate-2.schema.json",
  "title": "One captured bounded page of current multi-sport comparisons",
  "type": "object",
  "required": [
    "version",
    "view",
    "filter",
    "policy",
    "games",
    "boards",
    "errors",
    "stopped",
    "as_of",
    "bounds",
    "provider_requests",
    "read_revision",
    "epoch",
    "coverage",
    "read_token",
    "read_expires_at",
    "read_at"
  ],
  "properties": {
    "version": {
      "const": "predict-comparison-slate-2"
    },
    "view": {
      "enum": [
        "odds",
        "ev",
        "arbs"
      ]
    },
    "filter": {
      "enum": [
        "positive",
        "all",
        "hedges"
      ]
    },
    "policy": {
      "type": "object"
    },
    "games": {
      "$ref": "predict-board-catalog-2.schema.json#/properties/games"
    },
    "boards": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "predict-comparison-board-2.schema.json"
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "game_key",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "game_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "reason": {
            "type": "string",
            "maxLength": 512
          },
          "availability": {
            "type": "object",
            "required": [
              "version",
              "state",
              "reason_codes",
              "metrics",
              "numeric_metrics",
              "current_opportunity_eligible"
            ],
            "properties": {
              "version": {
                "const": "predict-calculation-availability-1"
              },
              "state": {
                "enum": [
                  "numeric_current",
                  "numeric_last_known",
                  "missing_reference",
                  "unsupported_inputs",
                  "calculation_failed",
                  "not_evaluated",
                  "missing_inputs"
                ]
              },
              "reason_codes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 160
                },
                "maxItems": 64,
                "uniqueItems": true
              },
              "numeric_metrics": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 5
              },
              "metrics": {
                "type": "object",
                "maxProperties": 5,
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "state",
                    "reason_codes"
                  ],
                  "properties": {
                    "state": {
                      "enum": [
                        "numeric_current",
                        "numeric_last_known",
                        "missing_reference",
                        "unsupported_inputs",
                        "calculation_failed",
                        "not_evaluated",
                        "missing_inputs"
                      ]
                    },
                    "reason_codes": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 160
                      },
                      "maxItems": 64,
                      "uniqueItems": true
                    }
                  },
                  "additionalProperties": false
                }
              },
              "current_opportunity_eligible": {
                "type": "boolean"
              },
              "evaluation_complete": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "stopped": {
      "type": "boolean"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "bounds": {
      "type": "object",
      "required": [
        "maximum_games",
        "maximum_bytes",
        "maximum_page_games"
      ],
      "properties": {
        "maximum_games": {
          "const": 500
        },
        "maximum_bytes": {
          "const": 8388608
        },
        "maximum_page_games": {
          "const": 50
        }
      }
    },
    "provider_requests": {
      "const": 0
    },
    "storage": {
      "type": "object"
    },
    "read_revision": {
      "type": "string",
      "minLength": 1
    },
    "epoch": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "type": "object",
      "required": [
        "total_games",
        "offset",
        "limit",
        "returned_games",
        "next_offset",
        "complete"
      ],
      "properties": {
        "total_games": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 499
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "returned_games": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 499
        },
        "complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "required": [
        "version",
        "scope",
        "games",
        "total_results",
        "numeric_results",
        "current_results",
        "positive_results",
        "counts",
        "outcome",
        "causes"
      ],
      "properties": {
        "version": {
          "const": "predict-calculation-availability-1"
        },
        "scope": {
          "const": "evaluated_results_before_filter"
        },
        "games": {
          "type": "integer",
          "minimum": 0
        },
        "total_results": {
          "type": "integer",
          "minimum": 0
        },
        "numeric_results": {
          "type": "integer",
          "minimum": 0
        },
        "current_results": {
          "type": "integer",
          "minimum": 0
        },
        "positive_results": {
          "type": "integer",
          "minimum": 0
        },
        "counts": {
          "type": "object",
          "required": [
            "numeric_current",
            "numeric_last_known",
            "missing_reference",
            "unsupported_inputs",
            "calculation_failed",
            "not_evaluated"
          ],
          "properties": {
            "numeric_current": {
              "type": "integer",
              "minimum": 0
            },
            "numeric_last_known": {
              "type": "integer",
              "minimum": 0
            },
            "missing_reference": {
              "type": "integer",
              "minimum": 0
            },
            "unsupported_inputs": {
              "type": "integer",
              "minimum": 0
            },
            "calculation_failed": {
              "type": "integer",
              "minimum": 0
            },
            "not_evaluated": {
              "type": "integer",
              "minimum": 0
            },
            "missing_inputs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "outcome": {
          "enum": [
            "not_evaluated",
            "unavailable",
            "partial",
            "last_known_only",
            "evaluated_no_positive",
            "positive"
          ]
        },
        "causes": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "code",
              "affected_results",
              "affected_games",
              "venues"
            ],
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 160
              },
              "affected_results": {
                "type": "integer",
                "minimum": 0
              },
              "affected_games": {
                "type": "integer",
                "minimum": 0
              },
              "venues": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 4
              }
            },
            "additionalProperties": false
          }
        },
        "evaluation_complete": {
          "type": "boolean"
        },
        "evaluated_results": {
          "type": "integer",
          "minimum": 0
        },
        "pending_results": {
          "type": "integer",
          "minimum": 0
        },
        "input_scope": {
          "type": "object"
        },
        "partial_results": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "collection": {
      "type": "object"
    },
    "read_at": {
      "type": "string",
      "maxLength": 64
    },
    "read_token": {
      "type": "string",
      "minLength": 32,
      "maxLength": 128
    },
    "read_expires_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    }
  }
}
