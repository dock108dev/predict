{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:predict:estimate-components:1",
  "title": "EV04 fixed-allocation successor components",
  "description": "Content/native/dependency hashes, exact units and allocation, scoped applicability and expiry are also validated by estimated_content and estimated_consumer. Future values do not establish actual facts.",
  "$defs": {
    "result": {
      "type": "object",
      "required": [
        "version",
        "components",
        "profile_refs",
        "profiles",
        "dependencies",
        "dependency_revision",
        "reasons",
        "acquisition_usd",
        "deployed_capital_usd",
        "settlement_already_withheld",
        "actual_qualified",
        "assumed_additional_charges",
        "grid_qualification",
        "fill_basis",
        "revision"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "predict-estimate-components-1"
        },
        "components": {
          "type": "object",
          "required": [
            "fee",
            "payout"
          ],
          "additionalProperties": false,
          "properties": {
            "fee": {
              "type": "object",
              "additionalProperties": {
                "$ref": "urn:predict:estimate:1#/$defs/input"
              }
            },
            "payout": {
              "type": "object",
              "additionalProperties": {
                "$ref": "urn:predict:estimate:1#/$defs/input"
              }
            }
          }
        },
        "profile_refs": {
          "type": "object",
          "required": [
            "fee",
            "payout"
          ],
          "additionalProperties": false,
          "properties": {
            "fee": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "payout": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "profiles": {
          "$ref": "urn:predict:comparison-inputs:2"
        },
        "dependencies": {
          "type": "object"
        },
        "dependency_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reasons": {
          "type": "object",
          "required": [
            "fee",
            "payout"
          ],
          "additionalProperties": false,
          "properties": {
            "fee": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "payout": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "acquisition_usd": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$"
        },
        "deployed_capital_usd": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?[0-9]+(?:\\.[0-9]+|/[1-9][0-9]*)?$"
        },
        "settlement_already_withheld": {
          "type": "boolean"
        },
        "actual_qualified": {
          "const": false
        },
        "assumed_additional_charges": {
          "type": "string"
        },
        "grid_qualification": {
          "type": "string"
        },
        "fill_basis": {
          "enum": [
            "explicit_supplied_fills",
            "hypothetical_one_order"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$ref": "#/$defs/result"
}
