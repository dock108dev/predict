#!/bin/sh
# Offline checks only. Run from the repository root with the intended Python on PATH.
set -eu
python -m compileall -q app tests
for source in app/dashboard/opportunity_static/*.js; do
    node --check "$source"
done
# Collector budgets measure process-lifetime peak RSS. Keep failure-injection
# fixtures separate from the retained dashboard/replay tests below.
python -m unittest tests.test_coverage_failure_handling -q
python -m unittest \
    tests.test_multi_game \
    tests.test_opportunity_board \
    tests.test_personal_beta \
    tests.test_failure_handling \
    tests.test_dashboard_security \
    tests.test_ssot_policy \
    tests.test_page_estimate \
    tests.test_multi_page \
    tests.test_math_reconciliation \
    -q
# A fresh process keeps collector RSS gates independent of retained-data oracle peak memory.
python -m unittest \
    tests.test_two_source_qualification \
    tests.test_native_retained_review \
    tests.test_native_public_review \
    tests.test_native_rule_review \
    tests.test_native_filing_review \
    tests.test_native_precedence_review \
    tests.test_native_us_rulebook_review \
    tests.test_precedence_deadlines \
    tests.test_public_request_deadline \
    tests.test_public_research_package \
    tests.test_public_research_repair \
    tests.test_future_qualification \
    tests.test_public_doc_package \
    tests.test_session_projection \
    tests.test_product_integration \
    tests.test_native_integration \
    tests.test_native_continuation \
    tests.test_reference_integration \
    tests.test_pinnacle_sample \
    tests.test_actual_references \
    tests.test_nhl \
    tests.test_mlb \
    tests.test_nba \
    tests.test_ncaaf \
    tests.test_ncaab \
    tests.test_score_lines \
    tests.test_nfl_lines \
    tests.test_ncaaf_lines \
    tests.test_mlb_lines \
    tests.test_nhl_lines \
    tests.test_nfl_first_half \
    tests.test_ncaaf_first_half \
    tests.test_nba_first_half \
    tests.test_ncaab_first_half \
    tests.test_nfl_resolution \
    tests.test_nba_resolution \
    tests.test_ncaaf_resolution \
    tests.test_ncaab_resolution \
    tests.test_diamond_ice_resolution \
    tests.test_periods \
    tests.test_futures \
    tests.test_college_expansion \
    tests.test_payout_extensions \
    -v
node tests/test_dashboard_failures.cjs
node tests/test_board_security.cjs
node tests/test_concise_dashboard.cjs
node tests/test_source_details.cjs

# Registry expansion keeps historical identities and captured matching intact.
python -m unittest \
    tests.test_normalization \
    tests.test_matching \
    tests.test_coverage \
    -q

# Retained moneyline replay stays pinned while explicit current bindings fail closed.
python -m unittest \
    tests.test_moneyline \
    -q
