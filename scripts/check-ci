#!/bin/sh
# Offline checks only. Run from the repository root with the intended Python on PATH.
set -eu
python -m compileall -q app tests
for source in app/dashboard/opportunity_static/*.js; do
    node --check "$source"
done
# Current-source contracts use only disposable state and injected transports.
# Run these before retained-data tests, whose process-lifetime RSS can be high.
python -m unittest \
    tests.test_current_contract \
    tests.test_current_state \
    tests.test_current_native \
    tests.test_current_confirmation \
    tests.test_current_occurrence \
    tests.test_current_occurrence_october8 \
    tests.test_current_quota \
    tests.test_current_clock_recovery \
    tests.test_current_odds_transport \
    -q
# Lifecycle/admin cases exercise the actual RSS watchdog. Each gets a fresh
# process so retained fixture allocations cannot change the memory gate.
python -m unittest tests.test_current_service -q
python -m unittest tests.test_current_aggregate -q
python -m unittest tests.test_current_admin -q
python -m unittest tests.test_u6_native_only -q
node tests/test_current_client.cjs
# Collector budgets measure process-lifetime peak RSS. Keep failure-injection
# fixtures separate from the retained dashboard/replay tests below.
python -m unittest tests.test_coverage_failure_handling tests.test_packaged_review_portability -q
python -m unittest tests.test_abend_handling tests.test_novig -q
python -m unittest tests.test_security_hardening -q
python -m unittest \
    tests.test_multi_game \
    tests.test_opportunity_board \
    tests.test_personal_beta \
    tests.test_failure_handling \
    tests.test_dashboard_security \
    tests.test_ssot_policy \
    tests.test_page_estimate \
    tests.test_multi_page \
    tests.test_math_reconciliation \
    -q
# A fresh process keeps collector RSS gates independent of retained-data oracle peak memory.
python -m unittest \
    tests.test_two_source_qualification \
    tests.test_native_retained_review \
    tests.test_native_public_review \
    tests.test_native_rule_review \
    tests.test_native_filing_review \
    tests.test_native_precedence_review \
    tests.test_native_us_rulebook_review \
    tests.test_precedence_deadlines \
    tests.test_public_request_deadline \
    tests.test_public_research_package \
    tests.test_public_research_repair \
    tests.test_future_qualification \
    tests.test_public_doc_package \
    tests.test_session_projection \
    tests.test_product_integration \
    tests.test_native_integration \
    tests.test_native_continuation \
    tests.test_reference_integration \
    tests.test_pinnacle_sample \
    tests.test_odds_sample \
    tests.test_odds_acquire \
    tests.test_odds_bindings \
    tests.test_actual_references \
    tests.test_nhl \
    tests.test_mlb \
    tests.test_nba \
    tests.test_ncaaf \
    tests.test_ncaab \
    tests.test_score_lines \
    tests.test_nfl_lines \
    tests.test_ncaaf_lines \
    tests.test_mlb_lines \
    tests.test_nhl_lines \
    tests.test_nfl_first_half \
    tests.test_ncaaf_first_half \
    tests.test_nba_first_half \
    tests.test_ncaab_first_half \
    tests.test_nfl_resolution \
    tests.test_nba_resolution \
    tests.test_ncaaf_resolution \
    tests.test_ncaab_resolution \
    tests.test_diamond_ice_resolution \
    tests.test_periods \
    tests.test_futures \
    tests.test_college_expansion \
    tests.test_payout_extensions \
    -v
node tests/test_dashboard_failures.cjs
node tests/test_board_security.cjs
node tests/test_concise_dashboard.cjs
node tests/test_source_details.cjs

# Registry expansion keeps historical identities and captured matching intact.
python -m unittest \
    tests.test_normalization \
    tests.test_matching \
    tests.test_coverage \
    -q

# Retained moneyline replay stays pinned while explicit current bindings fail closed.
python -m unittest \
    tests.test_moneyline \
    -q

# Same-outcome cards and the fresh bounded observation policy.
python -m unittest tests.test_price_comparison tests.test_multi_comparison tests.test_opportunity_feed tests.test_polymarket_us_stream -q
node tests/test_price_comparison.cjs
python -m unittest tests.test_freshness_repair tests.test_calculation_reuse -q
node tests/test_freshness_timing.cjs

# Browser-independent supervision and ordinary Stop on Game Details.
python -m unittest tests.test_supervised_observer tests.test_supervised_observer_integration tests.test_observer_capacity -q
node tests/test_session_controls.cjs

# Commercial decision support, watch transitions, history and retained-cutoff sizes.
python -m unittest tests.test_commercial_engineering -v
node tests/test_commercial_ui.cjs

# Required market cells through shared feed, sizing, watch and exact history.
python -m unittest tests.test_full_scope_engineering -v

# Synthetic saved packages run the shared aggregate guards without local archives.
# Archive oracles remain opt-in: tests.test_aggregate_ingestion / assessment.
python -m unittest tests.test_aggregate_portable -v
node tests/test_aggregate_ui.cjs

# Versioned H1 rule-analysis mechanics with fictional, hash-checked source bytes.
python -m unittest tests.test_aggregate_assessment_portable -v
node tests/test_aggregate_assessment_ui.cjs

# Full mathematical package, versioned hypothetical paths and retained reference sets.
python -m unittest tests.test_math_package -v
node tests/test_math_package.cjs

# Unified ordinary session on isolated transports; preservation and quota boundaries.
python -m unittest tests.test_source_session -v
node tests/test_source_settings.cjs
