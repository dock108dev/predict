name\":\"page-level-analytics\",\"enabled\":true,\"variant\":{\"name\":\"disabled\",\"enabled\":false,\"feature_enabled\":true},\"impressionData\":false},{\"name\":\"billing-updated-9-15\",\"enabled\":true,\"variant\":{\"name\":\"disabled\",\"enabled\":false,\"feature_enabled\":true},\"impressionData\":false}],\"children\":[\"$\",\"$L48\",null,{\"enabled\":false,\"children\":[\"$\",\"$L49\",\"kalshi-b198743e\",{\"children\":[\"$\",\"$L4a\",null,{\"children\":[\"$\",\"$L4b\",null,{\"subdomain\":\"kalshi-b198743e\",\"hasChatPermissions\":false,\"isLoggedInCli\":false,\"assistantConfig\":{},\"starterQuestions\":\"$undefined\",\"children\":[[\"$\",\"$L4c\",null,{}],[\"$\",\"$L4d\",null,{\"hasChatPermissions\":false}],[\"$\",\"style\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"html{--assistant-sheet-width:0px!important}\"}}],[\"$\",\"$L4e\",null,{\"children\":[[\"$\",\"$Le\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L10\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[\"$\",\"$L4f\",null,{\"source\":\"multitenant\"}],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}],\"$undefined\"]}]]}]}]}]}]}]}]}]\n"])</script><script>self.__next_f.push([1,"50:I[597003,[\"/mintlify-assets/_next/static/chunks/7578c347033fb4c7.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/b664fc8bb1e7ab0d.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/e820c38ea057e1be.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/e00dc38219d4677d.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/761250e423ee7acf.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/8048dcef7298cf99.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/31a3afc0dc19897f.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/a50f53db4fc4a3a7.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/eefca33900b5dff8.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/690c58d7e37f3613.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/389dadc29768f843.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/dd09caf47ab56047.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/d9038181f2c2898b.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/af823e43ed0e2094.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/09d635863667bc1f.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/4231b47cb33dea00.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/91103844efdcdc17.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/5c0aa8aebfcd5706.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/0bffe80727388774.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/ae3421c66bc64d81.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/0eb894a8519f24ea.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/ab18e2e34e91ec8d.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/9258da1973995d9b.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/4b75cadee2824500.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/d43bec961b360933.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/65712ea96ab292b5.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/8c8ace59a8592d70.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\"],\"ScopedNavProvider\"]\n"])</script><script>self.__next_f.push([1,"51:T148e,"])</script><script>self.__next_f.push([1,"Real-time CF Benchmarks index value updates, each carrying the raw upstream frame plus trailing 60-second and quarter-hour final-minute averages. Requires authentication.\n\n## Coins and index IDs\n\nUse the following CF Benchmarks index IDs to request coin data on this channel or through the [REST passthrough](/cfbenchmarks/rest-passthrough). The BTC and ETH examples on this page are illustrative; they are not the full list of coins.\n\n| Coin | CF Benchmarks index ID |\n|------|------------------------|\n| AAVE | `AAVEUSD_RTI` |\n| ADA | `ADAUSD_RTI` |\n| BCH | `BCHUSD_RTI` |\n| BNB | `BNBUSD_RTI` |\n| BTC | `BRTI` |\n| DOGE | `DOGEUSD_RTI` |\n| DOT | `DOTUSD_RTI` |\n| ETH | `ETHUSD_RTI` |\n| HBAR | `HBARUSD_RTI` |\n| HYPE | `HYPEUSD_RTI` |\n| LINK | `LINKUSD_RTI` |\n| LTC | `LTCUSD_RTI` |\n| NEAR | `NEARUSD_RTI` |\n| SHIB / kSHIB | `SHIBUSD_RTI` |\n| SOL | `SOLUSD_RTI` |\n| SUI | `SUIUSD_RTI` |\n| VVV | `VVVUSD_RTI` |\n| WLD | `WLDUSD_RTI` |\n| XLM | `XLMUSD_RTI` |\n| XRP | `XRPUSD_RTI` |\n| ZEC | `ZECUSD_RTI` |\n\nPass the index ID exactly as shown, rather than a coin symbol or Kalshi market ticker. For kSHIB, request `SHIBUSD_RTI`: values are USD per SHIB and are not scaled to kSHIB or a perpetual contract size.\n\nUse the `indexlist` action below to check the index IDs available on your WebSocket connection. Availability can change; this table is a coin-to-index reference, not a guarantee that every index is streaming in every environment.\n\nThe [5Hz feed](/websockets/cfbenchmarks-value-5hz) has a smaller coin set: BTC, ETH, SOL, XRP, and DOGE. Use `cfbenchmarks_value` for the other coins above.\n\n## Requirements\n\n- Authentication required\n- Index specification via `index_ids` (array of CF Benchmarks index IDs, for example `[\"BRTI\", \"ETHUSD_RTI\"]`)\n- `market_ticker`/`market_tickers`/`market_id`/`market_ids` are not supported for this channel\n- You can seed `index_ids` in the initial subscribe, or subscribe first and add indices later\n- Use `index_ids: [\"all\"]` to receive every available index\n- Supports `update_subscription` with `subscribe_indices` / `unsubscribe_indices` / `indexlist` actions\n- `indexlist` returns the available index IDs (as a `cfbenchmarks_value_indexlist` message) without modifying the subscription\n- Ticks are emitted roughly once per second; duplicate or out-of-order upstream source timestamps are ignored. For up to 5 updates per second on supported indices, see the [CF Benchmarks 5Hz Value Feed](/websockets/cfbenchmarks-value-5hz) sibling channel\n\n**Use case:** Consuming CF Benchmarks reference index values and their short-window averages\n\n## Subscription workflow\n\n1. Subscribe to `cfbenchmarks_value` (optionally seeding `index_ids`). A successful subscribe returns a `subscribed` response with the assigned `sid`.\n2. Discover available index IDs with the `indexlist` action; the server replies with a `cfbenchmarks_value_indexlist` message.\n3. Add or remove tracked index IDs with `subscribe_indices` / `unsubscribe_indices`, or use `index_ids: [\"all\"]` to track everything.\n\nFor example, subscribe to BNB, HYPE, and SHIB values:\n\n```json\n{\n  \"id\": 1,\n  \"cmd\": \"subscribe\",\n  \"params\": {\n    \"channels\": [\"cfbenchmarks_value\"],\n    \"index_ids\": [\"BNBUSD_RTI\", \"HYPEUSD_RTI\", \"SHIBUSD_RTI\"]\n  }\n}\n```\n\nTo discover the available indices, send the following after the `subscribed` response. Replace `sid: 1` with the subscription ID returned by the server:\n\n```json\n{\n  \"id\": 2,\n  \"cmd\": \"update_subscription\",\n  \"params\": {\n    \"sid\": 1,\n    \"action\": \"indexlist\"\n  }\n}\n```\n\nRead the available IDs from `msg.index_ids` in the `cfbenchmarks_value_indexlist` response. This lists the channel's available indices without changing which ones you subscribe to. A successful `subscribe` response alone does not confirm that a requested index is available.\n\n## Averaging semantics\n\n`avg_60s_data` (always present):\n- Window is trailing and per tick: `[source_ts_ms - 60000, source_ts_ms)`\n- `window_size` counts prior ticks only\n- If there are no prior ticks in the trailing window, the average falls back to the current tick value\n\n`last_60s_windowed_average_15min` (present only in the final minute before quarter-hour close: `:00`, `:15`, `:30`, `:45`):\n- Active accumulation window is `(quarter_close_ts_ms - 60000, quarter_close_ts_ms]`\n- The start-boundary tick is excluded and the close tick is included\n- This produces second-indexed counts: `:01 -\u003e 1`, `:14 -\u003e 14`, `:59 -\u003e 59`, close tick (`:00/:15/:30/:45`) -\u003e `60`\n- The field is omitted outside that final-minute window\n\n## Integration notes\n\n- If you subscribe without any `index_ids`, no value events flow until you add indices or switch to `[\"all\"]`\n- `sid` identifies the subscription stream; use it for `update_subscription` and `unsubscribe`\n- Missing `index_ids` for `subscribe_indices`/`unsubscribe_indices` returns an `error` with `code: 24` (\"Index IDs required\"); unsupported actions return a standard websocket `error`\n- This channel is real-time only. Historical index values — including intra-second granularity on some indices — are available over REST via the [CF Benchmarks REST Passthrough](/cfbenchmarks/rest-passthrough); live intra-second updates are available on the [`cfbenchmarks_value_5hz`](/websockets/cfbenchmarks-value-5hz) channel\n"])</script><script>self.__next_f.push([1,"52:Tacc,"])</script><script>self.__next_f.push([1,"Real-time CF Benchmarks index value updates at up to 5 updates per second, each carrying the raw upstream frame plus parsed value fields. Requires authentication.\n\nThis is the high-frequency sibling of the once-per-second [`cfbenchmarks_value`](/websockets/cfbenchmarks-value) channel. It carries BTC (`BRTI`), ETH (`ETHUSD_RTI`), SOL (`SOLUSD_RTI`), XRP (`XRPUSD_RTI`), and DOGE (`DOGEUSD_RTI`) at up to five updates per second. For BNB, HYPE, NEAR, ZEC, SUI, BCH, LTC, LINK, SHIB/kSHIB, ADA, WLD, AAVE, VVV, and other per-second indices, see the [coin and index ID table](/websockets/cfbenchmarks-value#coins-and-index-ids). Use this channel's `indexlist` action to discover its available IDs. Messages are lean raw ticks — they do not include the 60-second or quarter-hour averages, which stay on the per-second channel.\n\n**Requirements:**\n- Authentication required\n- Index specification via `index_ids` (array of CF Benchmarks index IDs, for example `[\"BRTI\", \"ETHUSD_RTI\"]`)\n- `market_ticker`/`market_tickers`/`market_id`/`market_ids` are not supported for this channel\n- You can seed `index_ids` in the initial subscribe, or subscribe first and add indices later\n- Use `index_ids: [\"all\"]` to receive every index available on this channel\n- Supports `update_subscription` with `subscribe_indices` / `unsubscribe_indices` / `indexlist` actions\n- `indexlist` returns the index IDs recently observed on this channel's stream (as a `cfbenchmarks_value_5hz_indexlist` message) without modifying the subscription\n- Up to 5 ticks per second per index; duplicate or out-of-order upstream source timestamps are ignored\n\n**Use case:** Consuming CF Benchmarks reference index values at the vendor's full publication rate\n\n**Subscription workflow:**\n1. Subscribe to `cfbenchmarks_value_5hz` (optionally seeding `index_ids`). A successful subscribe returns a `subscribed` response with the assigned `sid`.\n2. Discover the streaming index IDs with the `indexlist` action; the server replies with a `cfbenchmarks_value_5hz_indexlist` message.\n3. Add or remove tracked index IDs with `subscribe_indices` / `unsubscribe_indices`, or use `index_ids: [\"all\"]` to track everything on this channel.\n\n**Integration notes:**\n- If you subscribe without any `index_ids`, no value events flow until you add indices or switch to `[\"all\"]`\n- `sid` identifies the subscription stream; use it for `update_subscription` and `unsubscribe`\n- Missing `index_ids` for `subscribe_indices`/`unsubscribe_indices` returns an `error` with `code: 24` (\"Index IDs required\"); unsupported actions return a standard websocket `error`\n- Historical index values — including intra-second granularity — are available over REST via the [CF Benchmarks REST Passthrough](/cfbenchmarks/rest-passthrough)\n"])</script><script>self.__next_f.push([1,"53:T158a,"])</script><script>self.__next_f.push([1,"Real-time Pyth price updates for configured underlying tickers. Requires authentication.\n\n## Access and pricing\n\nThe Pyth data feed costs **$1,000/month**, with the **first seven days free**. [Subscribe to the Pyth data feed](https://buy.stripe.com/eVqaEXfmu9eN2ZB8gr4ZG0a).\n\nConnect using an authenticated Kalshi WebSocket session. See [Quick Start: WebSockets](/getting_started/quick_start_websockets#authentication) for API key authentication and request signing.\n\n## Commodities and underlying tickers\n\nThe reference table below includes spot metals, commodity futures, and indices. The gold and silver examples are only a subset of the feed coverage.\n\n| Pyth feed ID | Pyth symbol | Description |\n|--------------|-------------|-------------|\n| 345 | `Metal.XAG/USD` | Silver price in USD |\n| 346 | `Metal.XAU/USD` | Gold price in USD |\n| 2937 | `Commodities.CCU6/USD` | Cocoa futures (Sept 2026) in USD |\n| 3052 | `Commodities.COU6/USD` | Crude Oil futures (Sept 2026) in USD |\n| 3053 | `Commodities.COZ6/USD` | Crude Oil futures (Dec 2026) in USD |\n| 3080 | `Commodities.WHU6/USD` | Wheat futures (Sept 2026) in USD |\n| 3081 | `Commodities.WHZ6/USD` | Wheat futures (Dec 2026) in USD |\n| 3085 | `Commodities.SOU6/USD` | Soybeans futures (Sept 2026) in USD |\n| 3086 | `Commodities.SOX6/USD` | Soybeans futures (Nov 2026) in USD |\n| 3063 | `Commodities.Index.PYTHOIL/USD` | Blended Oil Index in USD |\n| 3153 | `Metal.Index.GOLD/USD` | Blended Gold Index in USD |\n| 3154 | `Metal.Index.SILVER/USD` | Blended Silver Index in USD |\n| 3045 | `Commodities.BRENTX6/USD` | Brent Crude futures (Nov 2026) in USD |\n| 3525 | `Commodities.Index.CU/USD` | Copper Index in USD |\n| 3265 | `Commodities.Index.NATGAS/USD` | Natural Gas Index in USD |\n| 3446 | `Commodities.Index.BRENT/USD` | Blended Brent Crude Index in USD |\n| 1781 | `Metal.XPT/USD` | Platinum price in USD |\n| 1780 | `Metal.XPD/USD` | Palladium price in USD |\n\nPass the exact **Pyth symbol** in `underlying_tickers`. The numeric Pyth feed IDs are reference information and are not subscription parameters for this channel. Kalshi market tickers are not Pyth underlying tickers.\n\nUse `underlying_list` to discover recently streamed tickers on your connection. Availability can change, including as futures contracts expire; the table does not guarantee that every feed is streaming in every environment.\n\n## Requirements\n\n- Authentication required\n- Seed `underlying_tickers` in the initial subscribe, or add them later\n- Use `underlying_tickers: [\"all\"]` to receive every available underlying\n- Supports `update_subscription` with `subscribe_underlyings`, `unsubscribe_underlyings`, and `underlying_list` actions\n- Duplicate and out-of-order source timestamps are ignored independently per underlying ticker\n\n## Subscription workflow\n\nSubscribe to `pyth_value` with the underlying tickers you want to receive. For example, request gold, oil, and natural gas prices:\n\n```json\n{\n  \"id\": 1,\n  \"cmd\": \"subscribe\",\n  \"params\": {\n    \"channels\": [\"pyth_value\"],\n    \"underlying_tickers\": [\n      \"Metal.XAU/USD\",\n      \"Commodities.Index.PYTHOIL/USD\",\n      \"Commodities.Index.NATGAS/USD\"\n    ]\n  }\n}\n```\n\nA successful subscribe returns a `subscribed` response with the assigned `sid`. Use that subscription ID in subsequent commands; replace `sid: 1` in the examples below with the returned ID.\n\nYou can also omit `underlying_tickers` to create an empty subscription, discover tickers, and add them later. An empty subscription sends no price updates until you add tickers or switch to `[\"all\"]`.\n\n### Discover recently streamed tickers\n\n```json\n{\n  \"id\": 2,\n  \"cmd\": \"update_subscription\",\n  \"params\": {\n    \"sid\": 1,\n    \"action\": \"underlying_list\"\n  }\n}\n```\n\nRead `msg.underlying_tickers` in the `pyth_value_underlying_list` response. This lists tickers observed on the stream within the last two hours without changing your subscription. It is not a complete catalog: inactive feeds can be absent. A successful subscribe response alone does not confirm that a requested ticker is streaming.\n\n### Add or remove tickers\n\nAdd platinum to the existing subscription:\n\n```json\n{\n  \"id\": 3,\n  \"cmd\": \"update_subscription\",\n  \"params\": {\n    \"sid\": 1,\n    \"action\": \"subscribe_underlyings\",\n    \"underlying_tickers\": [\"Metal.XPT/USD\"]\n  }\n}\n```\n\nRemove platinum from the subscription:\n\n```json\n{\n  \"id\": 4,\n  \"cmd\": \"update_subscription\",\n  \"params\": {\n    \"sid\": 1,\n    \"action\": \"unsubscribe_underlyings\",\n    \"underlying_tickers\": [\"Metal.XPT/USD\"]\n  }\n}\n```\n\n### Receive all available underlyings\n\nSet `underlying_tickers` to `[\"all\"]` in the initial subscribe, or enable it on an existing subscription:\n\n```json\n{\n  \"id\": 5,\n  \"cmd\": \"update_subscription\",\n  \"params\": {\n    \"sid\": 1,\n    \"action\": \"subscribe_underlyings\",\n    \"underlying_tickers\": [\"all\"]\n  }\n}\n```\n\nWhile all-mode is enabled, removing an individual ticker does not exclude it. Send `unsubscribe_underlyings` with `[\"all\"]` to disable all-mode; any explicitly subscribed tickers remain selected.\n\n## Integration notes\n\n- `sid` identifies the subscription stream; use it for `update_subscription` and `unsubscribe`.\n- Missing or empty `underlying_tickers` for `subscribe_underlyings` or `unsubscribe_underlyings` returns an `error` with `code: 28` (\"Underlying tickers required\").\n- `value_usd` is a USD price string formatted to eight decimal places.\n- `source_ts_ms` is the source timestamp in Unix milliseconds; `received_at` is when Kalshi received the update, also in Unix milliseconds.\n"])</script><script>self.__next_f.push([1,"19:[\"$\",\"$L50\",null,{\"scopedNav\":{\"global\":null,\"tabs\":[{\"tab\":\"Welcome\",\"pages\":[{\"title\":\"Welcome\",\"href\":\"/welcome\"}]},{\"tab\":\"Quick Start\",\"pages\":[{\"title\":\"Quick Start\",\"href\":\"/getting_started/api_environments\"}]},{\"tab\":\"Concepts\",\"pages\":[{\"title\":\"Concepts\",\"href\":\"/getting_started/making_your_first_request\"}]},{\"tab\":\"Predictions APIs\",\"groups\":[{\"group\":\"REST\",\"pages\":[{\"group\":\"exchange\",\"pages\":[{\"title\":\"Get Exchange Status\",\"description\":\" Endpoint for getting the exchange status.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /exchange/status\",\"href\":\"/api-reference/exchange/get-exchange-status\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Series Fee Changes\",\"description\":null,\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /series/fee_changes\",\"href\":\"/api-reference/exchange/get-series-fee-changes\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Exchange Schedule\",\"description\":\" Endpoint for getting the exchange schedule.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /exchange/schedule\",\"href\":\"/api-reference/exchange/get-exchange-schedule\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get User Data Timestamp\",\"description\":\" There is typically a short delay before exchange events are reflected in the API endpoints. Whenever possible, combine API responses to PUT/POST/DELETE requests with WebSocket data to obtain the most accurate view of the exchange state. This endpoint provides an approximate indication of when the data from the following endpoints was last validated: GetBalance, GetOrder(s), GetFills, GetPositions\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /exchange/user_data_timestamp\",\"href\":\"/api-reference/exchange/get-user-data-timestamp\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"market\",\"pages\":[{\"title\":\"Get Market Candlesticks\",\"description\":\"Time period length of each candlestick in minutes. Valid values: 1 (1 minute), 60 (1 hour), 1440 (1 day).\\nCandlesticks for markets that settled before the historical cutoff are only available via `GET /historical/markets/{ticker}/candlesticks`. See [Historical Data](https://docs.kalshi.com/getting_started/historical_data) for details.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /series/{series_ticker}/markets/{ticker}/candlesticks\",\"href\":\"/api-reference/market/get-market-candlesticks\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Trades\",\"description\":\"Endpoint for getting all trades for all markets. A trade represents a completed transaction between two users on a specific market. Each trade includes the market ticker, price, quantity, and timestamp information. Block trades are included in the response by default and identified by the `is_block_trade` field; use the `is_block_trade` query parameter to filter by block / non-block. This endpoint returns a paginated response. Use the 'limit' parameter to control page size (1-1000, defaults to 100). The response includes a 'cursor' field - pass this value in the 'cursor' parameter of your next request to get the next page. An empty cursor indicates no more pages are available.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /markets/trades\",\"href\":\"/api-reference/market/get-trades\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Market Orderbook\",\"description\":\" Endpoint for getting the current order book for a specific market.  The order book shows all active bid orders for both yes and no sides of a binary market. It returns yes bids and no bids only (no asks are returned). This is because in binary markets, a bid for yes at price X is equivalent to an ask for no at price (100-X). For example, a yes bid at 7¢ is the same as a no ask at 93¢, with identical contract sizes.  Each side shows price levels with their corresponding quantities and order counts, organized from best to worst prices.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /markets/{ticker}/orderbook\",\"href\":\"/api-reference/market/get-market-orderbook\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Multiple Market Orderbooks\",\"description\":\"Endpoint for getting the current order books for multiple markets in a single request. The order book shows all active bid orders for both yes and no sides of a binary market. It returns yes bids and no bids only (no asks are returned). This is because in binary markets, a bid for yes at price X is equivalent to an ask for no at price (100-X). For example, a yes bid at 7¢ is the same as a no ask at 93¢, with identical contract sizes. Each side shows price levels with their corresponding quantities and order counts, organized from best to worst prices. Returns one orderbook per requested market ticker.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /markets/orderbooks\",\"href\":\"/api-reference/market/get-multiple-market-orderbooks\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Series\",\"description\":\" Endpoint for getting data about a specific series by its ticker.  A series represents a template for recurring events that follow the same format and rules (e.g., \\\"Monthly Jobs Report\\\", \\\"Weekly Initial Jobless Claims\\\", \\\"Daily Weather in NYC\\\"). Series define the structure, settlement sources, and metadata that will be applied to each recurring event instance within that series.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /series/{series_ticker}\",\"href\":\"/api-reference/market/get-series\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Series List\",\"description\":\" Endpoint for getting data about multiple series with specified filters.  A series represents a template for recurring events that follow the same format and rules (e.g., \\\"Monthly Jobs Report\\\", \\\"Weekly Initial Jobless Claims\\\", \\\"Daily Weather in NYC\\\"). This endpoint allows you to browse and discover available series templates by category.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /series\",\"href\":\"/api-reference/market/get-series-list\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Markets\",\"description\":\"Filter by market status. Possible values: `unopened`, `open`, `closed`, `settled`. Leave empty to return markets with any status.\\n - Only one `status` filter may be supplied at a time.\\n - Timestamp filters will be mutually exclusive from other timestamp filters and certain status filters.\\n\\n | Compatible Timestamp Filters | Additional Status Filters| Extra Notes |\\n |------------------------------|--------------------------|-------------|\\n | min_created_ts, max_created_ts | `unopened`, `open`, *empty* | |\\n | min_close_ts, max_close_ts | `closed`, *empty* | |\\n | min_settled_ts, max_settled_ts | `settled`, *empty* | |\\n | min_updated_ts | *empty* | Incompatible with all filters besides `mve_filter=exclude`. May be combined with `series_ticker`, which requires `mve_filter=exclude` |\\n\\n Markets that settled before the historical cutoff are only available via `GET /historical/markets`. See [Historical Data](https://docs.kalshi.com/getting_started/historical_data) for details.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /markets\",\"href\":\"/api-reference/market/get-markets\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Market\",\"description\":\" Endpoint for getting data about a specific market by its ticker. A market represents a specific binary outcome within an event that users can trade on (e.g., \\\"Will candidate X win?\\\"). Markets have yes/no positions, current prices, volume, and settlement rules.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /markets/{ticker}\",\"href\":\"/api-reference/market/get-market\",\"autogeneratedByOpenApi\":true},{\"title\":\"Batch Get Market Candlesticks\",\"description\":\"Endpoint for retrieving candlestick data for multiple markets.\\n\\n- Accepts up to 100 market tickers per request\\n- Returns up to 10,000 candlesticks total across all markets\\n- Returns candlesticks grouped by market_id\\n- Optionally includes a synthetic initial candlestick for price continuity (see `include_latest_before_start` parameter)\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /markets/candlesticks\",\"href\":\"/api-reference/market/batch-get-market-candlesticks\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"events\",\"pages\":[{\"title\":\"Get Event Candlesticks\",\"description\":\" End-point for returning aggregated data across all markets corresponding to an event.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /series/{series_ticker}/events/{ticker}/candlesticks\",\"href\":\"/api-reference/events/get-event-candlesticks\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Events\",\"description\":\"Get all events. This endpoint excludes multivariate events.\\nTo retrieve multivariate events, use the GET /events/multivariate endpoint.\\nAll events are accessible through this endpoint, even if their associated markets are older than the historical cutoff.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /events\",\"href\":\"/api-reference/events/get-events\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Multivariate Events\",\"description\":\"Retrieve multivariate (combo) events. These are dynamically created events from multivariate event collections. Supports filtering by series and collection ticker.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /events/multivariate\",\"href\":\"/api-reference/events/get-multivariate-events\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Event Fee Changes\",\"description\":\"Event fees are an override layered on top of the parent series' fee structure. If `fee_type_override` and `fee_multiplier_override` are null, that indicates the override is cleared.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /events/fee_changes\",\"href\":\"/api-reference/events/get-event-fee-changes\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Event\",\"description\":\"Endpoint for getting data about an event by its ticker. An event represents a real-world occurrence that can be traded on, such as an election, sports game, or economic indicator release.\\nEvents contain one or more markets where users can place trades on different outcomes.\\nAll events are accessible through this endpoint, even if their associated markets are older than the historical cutoff.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /events/{event_ticker}\",\"href\":\"/api-reference/events/get-event\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Event Metadata\",\"description\":\" Endpoint for getting metadata about an event by its ticker.  Returns only the metadata information for an event.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /events/{event_ticker}/metadata\",\"href\":\"/api-reference/events/get-event-metadata\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Event Forecast Percentile History\",\"description\":\"Endpoint for getting the historical raw and formatted forecast numbers for an event at specific percentiles.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /series/{series_ticker}/events/{ticker}/forecast_percentile_history\",\"href\":\"/api-reference/events/get-event-forecast-percentile-history\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"orders\",\"pages\":[{\"title\":\"Get Orders\",\"description\":\"Restricts the response to orders that have a certain status: resting, canceled, or executed.\\nOrders that have been canceled or fully executed before the historical cutoff are only available via `GET /historical/orders`. Resting orders will always be available through this endpoint. See [Historical Data](https://docs.kalshi.com/getting_started/historical_data) for details.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /portfolio/orders\",\"href\":\"/api-reference/orders/get-orders\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Order\",\"description\":\" Endpoint for getting a single order.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /portfolio/orders/{order_id}\",\"href\":\"/api-reference/orders/get-order\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Queue Positions for Orders\",\"description\":\" Endpoint for getting queue positions for all resting orders. Queue position represents the number of contracts that need to be matched before an order receives a partial or full match, determined using price-time priority.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /portfolio/orders/queue_positions\",\"href\":\"/api-reference/orders/get-queue-positions-for-orders\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Order Queue Position\",\"description\":\" Endpoint for getting an order's queue position in the order book. This represents the amount of orders that need to be matched before this order receives a partial or full match. Queue position is determined using a price-time priority.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /portfolio/orders/{order_id}/queue_position\",\"href\":\"/api-reference/orders/get-order-queue-position\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create Order (V2)\",\"description\":\"Endpoint for submitting event-market orders using the V2 request/response shape (single-book `bid`/`ask` side and fixed-point dollar prices). The legacy `/portfolio/orders` endpoint will be deprecated no earlier than May 6, 2026 — clients should migrate to this path.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml post /portfolio/events/orders\",\"href\":\"/api-reference/orders/create-order-v2\",\"autogeneratedByOpenApi\":true},{\"title\":\"Cancel All Orders\",\"description\":\"Cancels all resting event-market orders for the authenticated Direct member across every exchange shard. If `subaccount` is omitted, matching orders may come from any subaccount. If it is provided, only orders for that subaccount are eligible. Newly placed orders may also be cancelled during the minute after the request.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml delete /portfolio/events/orders\",\"href\":\"/api-reference/orders/cancel-all-orders\",\"autogeneratedByOpenApi\":true},{\"title\":\"Batch Create Orders (V2)\",\"description\":\"Endpoint for submitting a batch of event-market orders using the V2 request/response shape. The maximum batch size scales with your tier's write budget — see [Rate Limits and Tiers](/getting_started/rate_limits).\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml post /portfolio/events/orders/batched\",\"href\":\"/api-reference/orders/batch-create-orders-v2\",\"autogeneratedByOpenApi\":true},{\"title\":\"Batch Cancel Orders (V2)\",\"description\":\"Endpoint for cancelling a batch of event-market orders using the V2 response shape. To auto-route a cancellation, provide its `market_ticker` and omit `exchange_index` or set it to `-1`. The maximum batch size scales with your tier's write budget — see [Rate Limits and Tiers](/getting_started/rate_limits).\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml delete /portfolio/events/orders/batched\",\"href\":\"/api-reference/orders/batch-cancel-orders-v2\",\"autogeneratedByOpenApi\":true},{\"title\":\"Cancel Order (V2)\",\"description\":\"Endpoint for cancelling event-market orders using the V2 response shape. To auto-route the cancellation, provide `market_ticker` and omit `exchange_index` or set it to `-1`. Returns `{order_id, client_order_id, reduced_by}` rather than a full order object.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml delete /portfolio/events/orders/{order_id}\",\"href\":\"/api-reference/orders/cancel-order-v2\",\"autogeneratedByOpenApi\":true},{\"title\":\"Amend Order (V2)\",\"description\":\"Endpoint for amending the price and/or max fillable count of an existing event-market order using the V2 request/response shape. The request `count` is the updated total/max fillable count, equal to already filled count plus desired resting remaining count. This behavior matches the v1 amend endpoints; only the request/response shape differs.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml post /portfolio/events/orders/{order_id}/amend\",\"href\":\"/api-reference/orders/amend-order-v2\",\"autogeneratedByOpenApi\":true},{\"title\":\"Decrease Order (V2)\",\"description\":\"Endpoint for decreasing the remaining count of an existing event-market order using the V2 request/response shape. Exactly one of `reduce_by` or `reduce_to` must be provided.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml post /portfolio/events/orders/{order_id}/decrease\",\"href\":\"/api-reference/orders/decrease-order-v2\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"order-groups\",\"pages\":[{\"title\":\"Get Order Groups\",\"description\":\" Retrieves all order groups for the authenticated user.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /portfolio/order_groups\",\"href\":\"/api-reference/order-groups/get-order-groups\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create Order Group\",\"description\":\" Creates a new order group with a contracts limit measured over a rolling 15-second window. Users can have up to 100,000 order groups at a time. When the limit is hit, all orders in the group are cancelled and no new orders can be placed until reset.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml post /portfolio/order_groups/create\",\"href\":\"/api-reference/order-groups/create-order-group\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Order Group\",\"description\":\" Retrieves details for a single order group including all order IDs and auto-cancel status.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /portfolio/order_groups/{order_group_id}\",\"href\":\"/api-reference/order-groups/get-order-group\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete Order Group\",\"description\":\" Deletes an order group and cancels all orders within it. This permanently removes the group.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml delete /portfolio/order_groups/{order_group_id}\",\"href\":\"/api-reference/order-groups/delete-order-group\",\"autogeneratedByOpenApi\":true},{\"title\":\"Reset Order Group\",\"description\":\" Resets the order group's matched contracts counter to zero, allowing new orders to be placed again after the limit was hit.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml put /portfolio/order_groups/{order_group_id}/reset\",\"href\":\"/api-reference/order-groups/reset-order-group\",\"autogeneratedByOpenApi\":true},{\"title\":\"Trigger Order Group\",\"description\":\" Triggers the order group, canceling all orders in the group and preventing new orders until the group is reset.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml put /portfolio/order_groups/{order_group_id}/trigger\",\"href\":\"/api-reference/order-groups/trigger-order-group\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update Order Group Limit\",\"description\":\" Updates the order group contracts limit (rolling 15-second window). If the updated limit would immediately trigger the group, all orders in the group are canceled and the group is triggered.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml put /portfolio/order_groups/{order_group_id}/limit\",\"href\":\"/api-reference/order-groups/update-order-group-limit\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"portfolio\",\"pages\":[{\"title\":\"Get Balance\",\"description\":\"Returns the balance and portfolio value for a member. Both values include all exchange indexes unless `exchange_index` is provided. Pass `subaccount` to use a subaccount instead of the primary account. This endpoint also accepts API keys with the 'read::portfolio_balance' scope.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /portfolio/balance\",\"href\":\"/api-reference/portfolio/get-balance\",\"autogeneratedByOpenApi\":true},{\"title\":\"Intra Account Transfer\",\"description\":\"Transfers funds within the same account.\\n\\nWhen `source_exchange_shard` and `destination_exchange_shard` are the same, Kalshi treats the request as a subaccount transfer. The returned transfer ID appears in the subaccount transfer history.\\n\\nCross-exchange-index subaccount transfers run in up to three non-atomic steps. If a later step fails, completed steps are not undone, so funds may remain in the primary account on the source or destination exchange index.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml post /portfolio/intra_exchange_instance_transfer\",\"href\":\"/api-reference/portfolio/intra-account-transfer\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Intra Account Transfers\",\"description\":\"Endpoint for fetching intra-exchange account transfer history.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /portfolio/intra_exchange_instance_transfers\",\"href\":\"/api-reference/portfolio/get-intra-account-transfers\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Intra Account Transfer\",\"description\":\"Endpoint for getting a single intra-account transfer by id.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /portfolio/intra_exchange_instance_transfers/{transfer_id}\",\"href\":\"/api-reference/portfolio/get-intra-account-transfer\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create Subaccount\",\"description\":\"Creates a new subaccount for the authenticated user. This endpoint is available to all users on the Advanced API tier and above. Subaccounts are numbered sequentially starting from 1. Maximum 63 numbered subaccounts per user (64 including the primary account).\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml post /portfolio/subaccounts\",\"href\":\"/api-reference/portfolio/create-subaccount\",\"autogeneratedByOpenApi\":true},{\"title\":\"Transfer Between Subaccounts\",\"description\":\"Transfers funds between the authenticated user's subaccounts. Use 0 for the primary account, or 1-63 for numbered subaccounts. Set exchange_index to apply the transfer on a specific exchange shard (defaults to 0).\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml post /portfolio/subaccounts/transfer\",\"href\":\"/api-reference/portfolio/transfer-between-subaccounts\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get All Subaccount Balances\",\"description\":\"Gets balances for all subaccounts including the primary account.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /portfolio/subaccounts/balances\",\"href\":\"/api-reference/portfolio/get-all-subaccount-balances\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Subaccount Transfers\",\"description\":\"Gets a paginated list of all transfers between subaccounts for the authenticated user.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /portfolio/subaccounts/transfers\",\"href\":\"/api-reference/portfolio/get-subaccount-transfers\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Subaccount Netting\",\"description\":\"Gets the netting enabled settings for all subaccounts.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /portfolio/subaccounts/netting\",\"href\":\"/api-reference/portfolio/get-subaccount-netting\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update Subaccount Netting\",\"description\":\"Updates the netting enabled setting for a specific subaccount. Use 0 for the primary account, or 1-63 for numbered subaccounts.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml put /portfolio/subaccounts/netting\",\"href\":\"/api-reference/portfolio/update-subaccount-netting\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Positions\",\"description\":\"Restricts the positions to those with any of following fields with non-zero values, as a comma separated list. The following values are accepted: position, total_traded.\\nRegistered partners may also use a user OAuth access token with the explicitly granted read::compliance_partner scope.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /portfolio/positions\",\"href\":\"/api-reference/portfolio/get-positions\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Settlements\",\"description\":\" Endpoint for getting the member's settlements historical track.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /portfolio/settlements\",\"href\":\"/api-reference/portfolio/get-settlements\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Deposits\",\"description\":\"Endpoint for getting the member's deposit history.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /portfolio/deposits\",\"href\":\"/api-reference/portfolio/get-deposits\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Withdrawals\",\"description\":\"Endpoint for getting the member's withdrawal history.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /portfolio/withdrawals\",\"href\":\"/api-reference/portfolio/get-withdrawals\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Total Resting Order Value\",\"description\":\" Endpoint for getting the total value, in cents, of resting orders. This endpoint is only intended for use by FCM members (rare). Note: If you're uncertain about this endpoint, it likely does not apply to you.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /portfolio/summary/total_resting_order_value\",\"href\":\"/api-reference/portfolio/get-total-resting-order-value\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Fills\",\"description\":\"Endpoint for getting all fills for the member. A fill is when a trade you have is matched.\\nRegistered partners may also use a user OAuth access token with the explicitly granted read::compliance_partner scope.\\nFills that occurred before the historical cutoff are only available via `GET /historical/fills`. See [Historical Data](https://docs.kalshi.com/getting_started/historical_data) for details.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /portfolio/fills\",\"href\":\"/api-reference/portfolio/get-fills\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Target Balance Allocation\",\"description\":\"Retrieves the caller's target balance allocation across exchange indexes.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /portfolio/target_balance_allocation\",\"href\":\"/api-reference/portfolio/get-target-balance-allocation\",\"autogeneratedByOpenApi\":true},{\"title\":\"Set Target Balance Allocation\",\"description\":\"Replaces the caller's target balance allocation across exchange indexes.\\nPercentages must total 100. Passing an empty allocations array disables automatic rebalancing.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml post /portfolio/target_balance_allocation\",\"href\":\"/api-reference/portfolio/set-target-balance-allocation\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"communications\",\"pages\":[{\"title\":\"Get Communications ID\",\"description\":\" Endpoint for getting the communications ID of the logged-in user.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /communications/id\",\"href\":\"/api-reference/communications/get-communications-id\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Block Trade Proposals\",\"description\":\" Endpoint for getting block trade proposals visible to the authenticated user.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /communications/block-trade-proposals\",\"href\":\"/api-reference/communications/get-block-trade-proposals\",\"autogeneratedByOpenApi\":true},{\"title\":\"Propose Block Trade\",\"description\":\" Endpoint for creating a block trade proposal.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml post /communications/block-trade-proposals\",\"href\":\"/api-reference/communications/propose-block-trade\",\"autogeneratedByOpenApi\":true},{\"title\":\"Accept Block Trade Proposal\",\"description\":\" Endpoint for accepting a block trade proposal.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml post /communications/block-trade-proposals/{block_trade_proposal_id}/accept\",\"href\":\"/api-reference/communications/accept-block-trade-proposal\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get RFQs\",\"description\":\"List RFQs. Pass pagination cursors back unchanged. A malformed cursor or invalid creator_user_id UUID returns HTTP 400. Use user_filter=self to filter by the authenticated user.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /communications/rfqs\",\"href\":\"/api-reference/communications/get-rfqs\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create RFQ\",\"description\":\" Endpoint for creating a new RFQ. You can have a maximum of 100 open RFQs at a time.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml post /communications/rfqs\",\"href\":\"/api-reference/communications/create-rfq\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get RFQ\",\"description\":\" Endpoint for getting a single RFQ by id\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /communications/rfqs/{rfq_id}\",\"href\":\"/api-reference/communications/get-rfq\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete RFQ\",\"description\":\" Endpoint for deleting an RFQ by ID\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml delete /communications/rfqs/{rfq_id}\",\"href\":\"/api-reference/communications/delete-rfq\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get RFQ Quote\",\"description\":\" Endpoint for getting a particular quote scoped to its RFQ.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /communications/rfqs/{rfq_id}/quotes/{quote_id}\",\"href\":\"/api-reference/communications/get-rfq-quote\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete RFQ Quote\",\"description\":\" Endpoint for deleting a quote scoped to its RFQ, which means it can no longer be accepted.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml delete /communications/rfqs/{rfq_id}/quotes/{quote_id}\",\"href\":\"/api-reference/communications/delete-rfq-quote\",\"autogeneratedByOpenApi\":true},{\"title\":\"Accept RFQ Quote\",\"description\":\" Endpoint for accepting a quote scoped to its RFQ. This will require the quoter to confirm.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml put /communications/rfqs/{rfq_id}/quotes/{quote_id}/accept\",\"href\":\"/api-reference/communications/accept-rfq-quote\",\"autogeneratedByOpenApi\":true},{\"title\":\"Confirm RFQ Quote\",\"description\":\" Endpoint for confirming a quote scoped to its RFQ. This will start a timer for order execution.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml put /communications/rfqs/{rfq_id}/quotes/{quote_id}/confirm\",\"href\":\"/api-reference/communications/confirm-rfq-quote\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Quotes\",\"description\":\"List quotes. The rfq_id filter requires an RFQ UUID. Pass pagination cursors back unchanged; malformed RFQ IDs or cursors return HTTP 400.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /communications/quotes\",\"href\":\"/api-reference/communications/get-quotes\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create Quote\",\"description\":\" Endpoint for creating a quote in response to an RFQ\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml post /communications/quotes\",\"href\":\"/api-reference/communications/create-quote\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Quote\",\"description\":\"DEPRECATED: Use GET /communications/rfqs/{rfq_id}/quotes/{quote_id} instead. Endpoint for getting a particular quote.\",\"deprecated\":true,\"version\":null,\"openapi\":\"/openapi.yaml get /communications/quotes/{quote_id}\",\"href\":\"/api-reference/communications/get-quote\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete Quote\",\"description\":\"DEPRECATED: Use DELETE /communications/rfqs/{rfq_id}/quotes/{quote_id} instead. Endpoint for deleting a quote, which means it can no longer be accepted.\",\"deprecated\":true,\"version\":null,\"openapi\":\"/openapi.yaml delete /communications/quotes/{quote_id}\",\"href\":\"/api-reference/communications/delete-quote\",\"autogeneratedByOpenApi\":true},{\"title\":\"Accept Quote\",\"description\":\"DEPRECATED: Use PUT /communications/rfqs/{rfq_id}/quotes/{quote_id}/accept instead. Endpoint for accepting a quote. This will require the quoter to confirm.\",\"deprecated\":true,\"version\":null,\"openapi\":\"/openapi.yaml put /communications/quotes/{quote_id}/accept\",\"href\":\"/api-reference/communications/accept-quote\",\"autogeneratedByOpenApi\":true},{\"title\":\"Confirm Quote\",\"description\":\"DEPRECATED: Use PUT /communications/rfqs/{rfq_id}/quotes/{quote_id}/confirm instead. Endpoint for confirming a quote. This will start a timer for order execution.\",\"deprecated\":true,\"version\":null,\"openapi\":\"/openapi.yaml put /communications/quotes/{quote_id}/confirm\",\"href\":\"/api-reference/communications/confirm-quote\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"api-keys\",\"pages\":[{\"title\":\"Get API Keys\",\"description\":\" Endpoint for retrieving all API keys associated with the authenticated user.  API keys allow programmatic access to the platform without requiring username/password authentication. Each key has a unique identifier and name.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /api_keys\",\"href\":\"/api-reference/api-keys/get-api-keys\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create API Key\",\"description\":\" Endpoint for creating a new API key with a user-provided public key.  This endpoint allows users with Premier or Market Maker API usage levels to create API keys by providing their own RSA public key. The platform will use this public key to verify signatures on API requests.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml post /api_keys\",\"href\":\"/api-reference/api-keys/create-api-key\",\"autogeneratedByOpenApi\":true},{\"title\":\"Generate API Key\",\"description\":\" Endpoint for generating a new API key with an automatically created key pair.  This endpoint generates both a public and private RSA key pair. The public key is stored on the platform, while the private key is returned to the user and must be stored securely. The private key cannot be retrieved again.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml post /api_keys/generate\",\"href\":\"/api-reference/api-keys/generate-api-key\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete API Key\",\"description\":\" Endpoint for deleting an existing API key.  This endpoint permanently deletes an API key. Once deleted, the key can no longer be used for authentication. This action cannot be undone.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml delete /api_keys/{api_key}\",\"href\":\"/api-reference/api-keys/delete-api-key\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"account\",\"pages\":[{\"title\":\"Get Account API Limits\",\"description\":\"Endpoint to retrieve the authenticated user's Predictions API usage tier and token-bucket limits. Public Predictions tiers include Basic, Advanced, Expert, Premier, Paragon, Prime, and Prestige.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /account/limits\",\"href\":\"/api-reference/account/get-account-api-limits\",\"autogeneratedByOpenApi\":true},{\"title\":\"Upgrade Account API Usage Level\",\"description\":\"Grants a permanent Advanced API usage-level grant. Currently only the Predictions exchange instance is supported. Criteria: at least 1 of the user's last 100 Predictions orders was created via API. Use Get Account API Limits to inspect the resulting usage tier and grants.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml post /account/api_usage_level/upgrade\",\"href\":\"/api-reference/account/upgrade-account-api-usage-level\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Account API Usage Level Volume Progress\",\"description\":\"Returns the authenticated user's latest cron-computed trading volume progress toward volume-based API usage tiers for the predictions (event_contract) lane. Volume figures are reported as fixed-point contract counts.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /account/api_usage_level/volume_progress\",\"href\":\"/api-reference/account/get-account-api-usage-level-volume-progress\",\"autogeneratedByOpenApi\":true},{\"title\":\"List Non-Default Endpoint Costs\",\"description\":\"Lists API v2 endpoints whose configured token cost differs from the default cost. Endpoints that use the default cost are omitted.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /account/endpoint_costs\",\"href\":\"/api-reference/account/list-non-default-endpoint-costs\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"search\",\"pages\":[{\"title\":\"Get Tags for Series Categories\",\"description\":\"Retrieve tags organized by series categories.\\n\\nThis endpoint returns a mapping of series categories to their associated tags, which can be used for filtering and search functionality.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /search/tags_by_categories\",\"href\":\"/api-reference/search/get-tags-for-series-categories\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Filters for Sports\",\"description\":\"Retrieve available filters organized by sport.\\n\\nThis endpoint returns filtering options available for each sport, including scopes and competitions. It also provides an ordered list of sports for display purposes.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /search/filters_by_sport\",\"href\":\"/api-reference/search/get-filters-for-sports\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"live-data\",\"pages\":[{\"title\":\"Get Live Data\",\"description\":\"Get live data for a specific milestone.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /live_data/milestone/{milestone_id}\",\"href\":\"/api-reference/live-data/get-live-data\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Live Data (with type)\",\"description\":\"Get live data for a specific milestone. This is the legacy endpoint that requires a type path parameter. Prefer using `/live_data/milestone/{milestone_id}` instead.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /live_data/{type}/milestone/{milestone_id}\",\"href\":\"/api-reference/live-data/get-live-data-with-type\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Multiple Live Data\",\"description\":\"Get live data for multiple milestones\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /live_data/batch\",\"href\":\"/api-reference/live-data/get-multiple-live-data\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Game Stats\",\"description\":\"Get play-by-play game statistics for a specific milestone. Supported sports: Pro Football, College Football, Pro Basketball, College Men's Basketball, College Women's Basketball, WNBA, Soccer, Pro Hockey, and Pro Baseball. Returns null for unsupported milestone types or milestones without a Sportradar ID.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /live_data/milestone/{milestone_id}/game_stats\",\"href\":\"/api-reference/live-data/get-game-stats\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Event Live Data\",\"description\":\"Get live data for an event by its event ticker. Serves event-keyed live data such as crypto price charts, commodity price timeseries, and weather observations. The `type` field in the response names the schema of the `details` object.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /live_data/events/{event_ticker}\",\"href\":\"/api-reference/live-data/get-event-live-data\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Weather Index\",\"description\":\"Get the Kalshi-computed city temperature index: the canonical minute-resolution series behind hourly temperature markets. City-keyed and independent of any event — the series exists whenever the city's index is configured. Values are Fahrenheit rounded to 0.01. Minutes where the index quorum failed carry no value and are never returned as points, so gaps in the series are real gaps. With `detailed=true` each point additionally carries every member station's reported reading and quality-control disposition — the pre-incorporation breakdown.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /live_data/weather/{city}\",\"href\":\"/api-reference/live-data/get-weather-index\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Weather Index Calibrations\",\"description\":\"Get a city's published weather-index configuration timeline: the launch configuration plus every weekly offset calibration and methodology update, ascending by effective time. Each record carries the station weights, station offsets (Celsius), and the city reference used to compute index values from the record's effective time until the next record — everything needed to reproduce published index values for minutes computed under that configuration version. Offsets are re-estimated weekly after each complete UTC week; weights never change through calibration. The timeline is append-only and complete: it is never trimmed.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /live_data/weather/{city}/calibrations\",\"href\":\"/api-reference/live-data/get-weather-index-calibrations\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"structured-targets\",\"pages\":[{\"title\":\"Get Structured Targets\",\"description\":\"Page size (min: 1, max: 2000)\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /structured_targets\",\"href\":\"/api-reference/structured-targets/get-structured-targets\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Structured Target\",\"description\":\" Endpoint for getting data about a specific structured target by its ID.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /structured_targets/{structured_target_id}\",\"href\":\"/api-reference/structured-targets/get-structured-target\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"milestone\",\"pages\":[{\"title\":\"Get Milestone\",\"description\":\" Endpoint for getting data about a specific milestone by its ID.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /milestones/{milestone_id}\",\"href\":\"/api-reference/milestone/get-milestone\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Milestones\",\"description\":\"Minimum start date to filter milestones. Format: RFC3339 timestamp\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /milestones\",\"href\":\"/api-reference/milestone/get-milestones\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"multivariate\",\"pages\":[{\"title\":\"Get Multivariate Event Collection\",\"description\":\" Endpoint for getting data about a multivariate event collection by its ticker.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /multivariate_event_collections/{collection_ticker}\",\"href\":\"/api-reference/multivariate/get-multivariate-event-collection\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create Market In Multivariate Event Collection\",\"description\":\"Endpoint for creating an individual market in a multivariate event collection. This endpoint must be hit at least once before trading or looking up a market. Users are limited to 5000 creations per week.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml post /multivariate_event_collections/{collection_ticker}\",\"href\":\"/api-reference/multivariate/create-market-in-multivariate-event-collection\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Multivariate Event Collections\",\"description\":\" Endpoint for getting data about multivariate event collections.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /multivariate_event_collections\",\"href\":\"/api-reference/multivariate/get-multivariate-event-collections\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"incentive-programs\",\"pages\":[{\"title\":\"Get Incentives\",\"description\":\" List incentives with optional filters. Incentives are rewards programs for trading activity on specific markets.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /incentive_programs\",\"href\":\"/api-reference/incentive-programs/get-incentives\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"fcm\",\"pages\":[{\"title\":\"Get FCM Orders\",\"description\":\"Endpoint for FCM members to get orders for their subtraders.\\nThis endpoint requires FCM member access level. At least one of `subtrader_id` or\\n`client_order_ids` is required; supplying both returns only the orders matching both filters.\\nAPI keys bound to a single FCM subtrader may also call this endpoint: `subtrader_id` may be\\nomitted and defaults to the key's bound subtrader, and if supplied it must equal the bound\\nsubtrader or the request is rejected.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /fcm/orders\",\"href\":\"/api-reference/fcm/get-fcm-orders\",\"autogeneratedByOpenApi\":true},{\"title\":\"List FCM Subtraders\",\"description\":\"Lists the authenticated FCM's event-contract subtraders, including accounts with\\nno trades. Exchange metadata is asynchronous, so newly created accounts may not\\nappear immediately. Trading block status includes firm-wide and Kalshi restrictions;\\nfcm_trading_blocked identifies the FCM's own per-subtrader restriction.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /fcm/subtraders\",\"href\":\"/api-reference/fcm/list-fcm-subtraders\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create FCM Subtrader\",\"description\":\"Endpoint for FCM members to create a subtrader on the event-contract exchange. The\\nsubtrader is registered on every exchange shard that knows the FCM; a shard provisioned\\nlater registers it lazily on the subtrader's first order there. Re-creating an existing\\nsubtrader returns 409.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml post /fcm/subtraders\",\"href\":\"/api-reference/fcm/create-fcm-subtrader\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get FCM Subtrader Event Contract Daily Cap\",\"description\":\"Returns the event-contract daily premium cap configured for an FCM member's subtrader,\\ntogether with its live utilization. Executed utilization is the net premium deployed by\\nfills today (sells and settlements credit back); resting and pending utilization reserve\\nopen and in-flight orders at their full worst-case cost plus fees. Executed utilization\\nresets at midnight New York time on the returned cap date; resting and pending\\nreservations persist for as long as their orders remain open, including across the reset.\\nReturns 404 when the subtrader has no cap configured — in that state every order placed\\nthrough the subtrader's bound API keys is rejected.\\nAPI keys bound to a single FCM subtrader may also call this endpoint: `subtrader_id` may be\\nomitted and defaults to the key's bound subtrader, and if supplied it must equal the bound\\nsubtrader or the request is rejected.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /fcm/subtraders/event_contract_daily_cap\",\"href\":\"/api-reference/fcm/get-fcm-subtrader-event-contract-daily-cap\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update FCM Subtrader Event Contract Daily Cap\",\"description\":\"Sets the event-contract daily premium cap for an FCM member's subtrader. The cap bounds\\nthe subtrader's net premium at risk per trading day. It is enforced on cap-reservation\\nsessions — which every subtrader-bound API key uses — and is mandatory there: a subtrader\\nwith no cap cannot trade through its bound keys. Cap changes take effect immediately;\\nexisting resting orders are never cancelled by a cap change.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml put /fcm/subtraders/event_contract_daily_cap\",\"href\":\"/api-reference/fcm/update-fcm-subtrader-event-contract-daily-cap\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete FCM Subtrader Event Contract Daily Cap\",\"description\":\"Removes the event-contract daily premium cap for an FCM member's subtrader. Removal\\ncloses the subtrader to new orders on cap-reservation sessions — every subtrader-bound\\nAPI key — until a cap is set again. It does not stop orders your own unbound sessions\\nsubmit on the subtrader's behalf; to stop the account entirely, block subtrader trading.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml delete /fcm/subtraders/event_contract_daily_cap\",\"href\":\"/api-reference/fcm/delete-fcm-subtrader-event-contract-daily-cap\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get FCM Subtrader Blocked Categories\",\"description\":\"Returns the event categories an FCM member has blocked for one of its\\nsubtraders. The subtrader must belong to the requesting FCM. A subtrader\\nwith no blocks returns an empty list.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /fcm/subtraders/blocked_categories\",\"href\":\"/api-reference/fcm/get-fcm-subtrader-blocked-categories\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update FCM Subtrader Blocked Categories\",\"description\":\"Adds one event category to, or removes one from, the set an FCM member\\nhas blocked for one of its subtraders. The subtrader must belong to the\\nrequesting FCM. Blocks apply prospectively: new orders the subtrader\\nplaces through its bound API credentials are rejected in markets whose\\nevent belongs to a blocked category, while orders already resting are\\nnot cancelled. Returns the subtrader's full resulting blocked set.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml put /fcm/subtraders/blocked_categories\",\"href\":\"/api-reference/fcm/update-fcm-subtrader-blocked-categories\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get FCM Positions\",\"description\":\"Endpoint for FCM members to get market positions filtered by subtrader ID.\\nThis endpoint requires FCM member access level and allows filtering positions by subtrader ID.\\nAPI keys bound to a single FCM subtrader may also call this endpoint: `subtrader_id` may be\\nomitted and defaults to the key's bound subtrader, and if supplied it must equal the bound\\nsubtrader or the request is rejected.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /fcm/positions\",\"href\":\"/api-reference/fcm/get-fcm-positions\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"historical\",\"pages\":[{\"title\":\"Get Historical Cutoff Timestamps\",\"description\":\"Returns the cutoff timestamps that define the boundary between **live** and **historical** data.\\n\\n## Cutoff fields\\n- `market_settled_ts` : Markets that **settled** before this timestamp, and their candlesticks, must be accessed via `GET /historical/markets` and `GET /historical/markets/{ticker}/candlesticks`.\\n- `trades_created_ts` : Trades that were **filled** before this timestamp must be accessed via `GET /historical/fills`.\\n- `orders_updated_ts` : Orders that were **canceled or fully executed** before this timestamp must be accessed via `GET /historical/orders`. Resting (active) orders are always available in `GET /portfolio/orders`.\\n- `market_positions_last_updated_ts` : Settled positions **archived from the live data set** before this timestamp must be accessed via `GET /historical/positions`. Unsettled positions are always available in `GET /portfolio/positions`.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /historical/cutoff\",\"href\":\"/api-reference/historical/get-historical-cutoff-timestamps\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Historical Market Candlesticks\",\"description\":\" Endpoint for fetching historical candlestick data for markets that have been archived from the live data set. Time period length of each candlestick in minutes. Valid values: 1 (1 minute), 60 (1 hour), 1440 (1 day).\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /historical/markets/{ticker}/candlesticks\",\"href\":\"/api-reference/historical/get-historical-market-candlesticks\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Historical Fills\",\"description\":\"Endpoint for getting all historical fills for the member. A fill is when a trade you have is matched.\\nAPI keys restricted to a subaccount return only that subaccount's fills. If supplied, `subaccount` must match the key's restriction.\\nRegistered partners may also use a user OAuth access token with the explicitly granted read::compliance_partner scope.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /historical/fills\",\"href\":\"/api-reference/historical/get-historical-fills\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Historical Orders\",\"description\":\"Endpoint for getting orders that have been archived to the historical database.\\nAPI keys restricted to a subaccount return only that subaccount's orders. If supplied, `subaccount` must match the key's restriction.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /historical/orders\",\"href\":\"/api-reference/historical/get-historical-orders\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Historical Positions\",\"description\":\" Endpoint for getting settled market positions that have been archived to the historical database. Positions whose markets were archived before `market_positions_last_updated_ts` on `GET /historical/cutoff` are available via this endpoint. Positions are archived per whole event: a settled event's positions move here together and are never split between this endpoint and `GET /portfolio/positions`. Unsettled positions are always available via `GET /portfolio/positions`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /historical/positions\",\"href\":\"/api-reference/historical/get-historical-positions\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Historical Trades\",\"description\":\" Endpoint for getting all historical trades for all markets. Trades that were filled before the historical cutoff are available via this endpoint. Block trades are included by default and identified by the `is_block_trade` field; use the `is_block_trade` query parameter to filter by block / non-block. See [Historical Data](https://docs.kalshi.com/getting_started/historical_data) for details.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /historical/trades\",\"href\":\"/api-reference/historical/get-historical-trades\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Historical Markets\",\"description\":\"Endpoint for getting markets that have been archived to the historical database. Filters are mutually exclusive.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /historical/markets\",\"href\":\"/api-reference/historical/get-historical-markets\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Historical Market\",\"description\":\" Endpoint for getting data about a specific market by its ticker from the historical database.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi.yaml get /historical/markets/{ticker}\",\"href\":\"/api-reference/historical/get-historical-market\",\"autogeneratedByOpenApi\":true}]}]},{\"group\":\"CF Benchmarks REST\",\"pages\":[{\"title\":\"CF Benchmarks REST Passthrough\",\"description\":\"Query CF Benchmarks REST data using your existing Kalshi API credentials\",\"href\":\"/cfbenchmarks/rest-passthrough\"}]},{\"group\":\"WebSockets\",\"pages\":[{\"title\":\"WebSocket API\",\"description\":\"Trade API WebSocket endpoint and schema reference\",\"href\":\"/websockets\"},{\"title\":\"WebSocket Connection\",\"asyncapi\":\"asyncapi.yaml root\",\"description\":\"Main WebSocket connection endpoint. All communication happens through this single connection.\\nAuthentication is required to establish the connection; include API key headers during the WebSocket handshake.\\nSome channels carry only public market data, but the connection itself still requires authentication.\\nUse the subscribe command to subscribe to specific data channels. For more information, see the [Getting Started](https://docs.kalshi.com/getting_started/quick_start_websockets) guide.\\n\",\"href\":\"/websockets/websocket-connection\"},{\"title\":\"Connection Keep-Alive\",\"asyncapi\":\"asyncapi.yaml control_frames\",\"description\":\"WebSocket control frames for connection management.\\n\\nKalshi sends Ping frames (`0x9`) every 10 seconds with body `heartbeat` to maintain the connection.\\nClients should respond with Pong frames (`0xA`). Clients may also send Ping frames to which Kalshi will respond with Pong.\\n\",\"href\":\"/websockets/connection-keep-alive\"},{\"title\":\"Orderbook Updates\",\"asyncapi\":\"asyncapi.yaml orderbook_delta\",\"description\":\"Real-time orderbook price level changes. Provides incremental updates to maintain a live orderbook.\\n\\n**Requirements:**\\n- Authentication required\\n- Market specification required:\\n  - Use `market_ticker` (string) for a single market\\n  - Use `market_tickers` (array of strings) for multiple markets\\n  - `market_id`/`market_ids` are not supported for this channel\\n- Sends `orderbook_snapshot` first, then incremental `orderbook_delta` updates\\n- Supports `update_subscription` with `add_markets` / `delete_markets` / `get_snapshot` actions\\n- `get_snapshot` returns an `orderbook_snapshot` for the requested `market_tickers` without modifying the subscription\\n\\n**Use case:** Building and maintaining a real-time orderbook\\n\",\"href\":\"/websockets/orderbook-updates\"},{\"title\":\"Market Ticker\",\"asyncapi\":\"asyncapi.yaml ticker\",\"description\":\"Market price, volume, and open interest updates.\\n\\n**Requirements:**\\n- No additional channel-level authentication beyond the authenticated WebSocket connection\\n- Market specification optional (omit to receive all markets)\\n- Supports `market_ticker`/`market_tickers` and `market_id`/`market_ids`\\n- Updates sent whenever any ticker field changes\\n\\n**Use case:** Displaying current market prices and statistics\\n\",\"href\":\"/websockets/market-ticker\"},{\"title\":\"CF Benchmarks Value Feed\",\"asyncapi\":\"asyncapi.yaml cfbenchmarks_value\",\"description\":\"$51\",\"href\":\"/websockets/cfbenchmarks-value\"},{\"title\":\"CF Benchmarks 5Hz Value Feed\",\"asyncapi\":\"asyncapi.yaml cfbenchmarks_value_5hz\",\"description\":\"$52\",\"href\":\"/websockets/cfbenchmarks-value-5hz\"},{\"title\":\"Pyth Value Feed\",\"asyncapi\":\"asyncapi.yaml pyth_value\",\"description\":\"$53\",\"href\":\"/websockets/pyth-value\"},{\"title\":\"Public Trades\",\"asyncapi\":\"asyncapi.yaml trade\",\"description\":\"Public trade notifications when trades occur.\\n\\n**Requirements:**\\n- No additional channel-level authentication beyond the authenticated WebSocket connection\\n- Market specification optional (omit to receive all trades)\\n- Updates sent immediately after trade execution\\n\\n**Use case:** Trade feed, volume analysis\\n\",\"href\":\"/websockets/public-trades\"},{\"title\":\"User Fills\",\"asyncapi\":\"asyncapi.yaml fill\",\"description\":\"Your order fill notifications. Requires authentication.\\n\\n**Requirements:**\\n- Authentication required\\n- Market specification optional via `market_ticker`/`market_tickers` (omit to receive all your fills)\\n- Supports `update_subscription` with `add_markets` / `delete_markets`\\n- Updates sent immediately when your orders are filled\\n\\n**Use case:** Tracking your trading activity\\n\",\"href\":\"/websockets/user-fills\"},{\"title\":\"Market Positions\",\"asyncapi\":\"asyncapi.yaml market_positions\",\"description\":\"Real-time updates of your positions in markets. Requires authentication.\\n\\n**Requirements:**\\n- Authentication required\\n- Market specification optional (omit to receive all positions)\\n- Filters are by `market_ticker`/`market_tickers` only; `market_id`/`market_ids` are not supported\\n- Updates sent when your position changes due to trades, settlements, etc.\\n\\n**Monetary Values:**\\nAll monetary values are returned as fixed-point dollar strings (`_dollars` suffix).\\n\\n**Use case:** Portfolio tracking, position monitoring, P\u0026L calculations\\n\",\"href\":\"/websockets/market-positions\"},{\"title\":\"Market \u0026 Event Lifecycle\",\"asyncapi\":\"asyncapi.yaml market_lifecycle_v2\",\"description\":\"Market state changes and event creation notifications.\\n\\n**Requirements:**\\n- No additional channel-level authentication beyond the authenticated WebSocket connection\\n- Receives all market and event lifecycle notifications (`market_ticker` filters are not supported)\\n- Event creation notifications\\n\\n**Use case:** Tracking market lifecycle including creation, de(activation), close date changes, determination, settlement, price level structure changes, and metadata updates\\n\",\"href\":\"/websockets/market-and-event-lifecycle\"},{\"title\":\"Multivariate Market \u0026 Event Lifecycle\",\"asyncapi\":\"asyncapi.yaml multivariate_market_lifecycle\",\"description\":\"Multivariate event (MVE) market state changes and event creation notifications.\\n\\n**Requirements:**\\n- No additional channel-level authentication beyond the authenticated WebSocket connection\\n- Receives all multivariate market lifecycle notifications (`market_ticker` filters are not supported)\\n- Only emits lifecycle updates for multivariate events\\n- Event creation notifications\\n\\n**Use case:** Tracking multivariate market lifecycle including creation, de(activation), close date changes, determination, settlement\\n\",\"href\":\"/websockets/multivariate-market-and-event-lifecycle\"},{\"title\":\"Communications\",\"asyncapi\":\"asyncapi.yaml communications\",\"description\":\"Real-time Request for Quote (RFQ) and quote notifications. Requires authentication.\\n\\n**Requirements:**\\n- Authentication required\\n- Market specification ignored\\n- Optional sharding for fanout control:\\n  - `shard_factor` (1-100) and `shard_key` (`0 \u003c= key \u003c shard_factor`)\\n- RFQ events (RFQCreated, RFQDeleted) always sent\\n- Quote events (QuoteCreated, QuoteAccepted, QuoteExecuted) are only sent if you created the quote OR you created the RFQ\\n\\n**Use case:** Tracking RFQs you create and quotes on your RFQs, or quotes you create on others' RFQs. Use QuoteExecuted to correlate fill messages with quotes via client_order_id.\\n\",\"href\":\"/websockets/communications\"},{\"title\":\"Order Group Updates\",\"asyncapi\":\"asyncapi.yaml order_group_updates\",\"description\":\"Real-time order group lifecycle and limit updates. Requires authentication.\\n\\n**Requirements:**\\n- Authentication required\\n- Market specification ignored\\n- Updates sent when order groups are created, triggered, reset, deleted, or have limits updated\\n\\n**Use case:** Tracking order group lifecycle and limits\\n\",\"href\":\"/websockets/order-group-updates\"},{\"title\":\"User Orders\",\"asyncapi\":\"asyncapi.yaml user_orders\",\"description\":\"Real-time order created and updated notifications. Requires authentication.\\n\\n**Requirements:**\\n- Authentication required\\n- Market specification optional via `market_tickers` (omit to receive all orders)\\n- Supports `update_subscription` with `add_markets` / `delete_markets` actions\\n- Updates sent when your orders are created, filled, canceled, or otherwise updated\\n\\n**Use case:** Tracking your resting orders, fills, and cancellations in real time\\n\",\"href\":\"/websockets/user-orders\"}]},{\"group\":\"FIX\",\"pages\":[{\"title\":\"Common Components\",\"description\":\"Standard header, trailer, and shared components across all FIX messages\",\"icon\":\"puzzle-piece\",\"href\":\"/fix/common-components\"},{\"title\":\"Connectivity\",\"description\":\"Endpoints, transport configuration, and rate limits for the Kalshi FIX API\",\"icon\":\"network-wired\",\"href\":\"/fix/connectivity\"},{\"title\":\"Authentication \u0026 Sessions\",\"description\":\"API key creation, logon, session lifecycle, and message retransmission\",\"icon\":\"key\",\"href\":\"/fix/authentication\"},{\"title\":\"Order Entry\",\"description\":\"Submit, modify, and cancel orders through FIX messages\",\"icon\":\"cart-plus\",\"href\":\"/fix/order-entry\"},{\"title\":\"Order Groups\",\"description\":\"Manage order groups for automatic position management\",\"icon\":\"layer-group\",\"href\":\"/fix/order-groups\"},{\"title\":\"Market Data\",\"description\":\"Request order book snapshots and incremental updates through FIX\",\"icon\":\"chart-line\",\"href\":\"/fix/market-data\"},{\"title\":\"RFQ\",\"description\":\"Request for Quote functionality for RFQ creators and market makers\",\"icon\":\"comments-dollar\",\"href\":\"/fix/rfq-messages\"},{\"title\":\"Drop Copy Session\",\"description\":\"Recover missed execution reports and query historical order events\",\"icon\":\"copy\",\"href\":\"/fix/drop-copy\"},{\"title\":\"Listener Sessions\",\"description\":\"Real-time read-only feed of execution reports from your trading session\",\"icon\":\"headphones\",\"href\":\"/fix/listener-sessions\"},{\"title\":\"Market Settlement\",\"description\":\"Settlement reports for market outcomes and position resolution\",\"icon\":\"circle-check\",\"href\":\"/fix/market-settlement\"},{\"title\":\"Error Handling\",\"description\":\"Understanding and handling errors in the FIX protocol\",\"icon\":\"triangle-exclamation\",\"href\":\"/fix/error-handling\"},{\"title\":\"Subpenny Pricing\",\"description\":\"Dollar-based pricing format for subpenny precision\",\"icon\":\"dollar-sign\",\"href\":\"/fix/subpenny-pricing\"}]}]},{\"tab\":\"Perps APIs\",\"pages\":[{\"title\":\"Perps APIs\",\"href\":\"/margin\"}]},{\"tab\":\"Changelog\",\"pages\":[{\"title\":\"Changelog\",\"href\":\"/changelog\"}]}]},\"maps\":{\"firstHrefInVersion\":{},\"firstHrefInLanguage\":{}},\"children\":\"$L54\"}]\n"])</script><script>self.__next_f.push([1,"55:I[763509,[\"/mintlify-assets/_next/static/chunks/7578c347033fb4c7.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/b664fc8bb1e7ab0d.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/e820c38ea057e1be.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/e00dc38219d4677d.js?dpl=dpl_WUrXqCd5nPFDSzoTYvx4Wt8NzcVY\",\"/mintlify-assets/_next/static/chunks/761250e423ee7acf.js?dpl=dp