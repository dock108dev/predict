/kalshi-bg.svg\");\n}\n\n.docs-home-hero-bg-dark {\n  display: none;\n  background-image: url(\"https://mintlify-assets.b-cdn.net/kalshi-dark-bg.svg\");\n}\n\n.dark .docs-home-hero-bg-light {\n  display: none;\n}\n\n.dark .docs-home-hero-bg-dark {\n  display: block;\n}\n\n.docs-home-hero-content {\n  position: absolute;\n  width: min(45rem, calc(100% - 2rem));\n  padding: 0 1rem;\n  text-align: center;\n  color: #000;\n}\n\n.dark .docs-home-hero-content {\n  color: #fff;\n}\n\n.docs-home-hero-title {\n  margin: 0;\n  font-family: Inter, sans-serif;\n  font-size: 36px;\n  font-weight: 500;\n  line-height: 44px;\n}\n\n.docs-home-hero-subtitle {\n  margin-top: 1rem;\n  font-size: 18px;\n  font-weight: 400;\n  opacity: 0.6;\n}\n\n.docs-home-hero-agreement {\n  margin-top: 0.75rem;\n  font-size: 14px;\n  font-weight: 400;\n}\n\n.docs-home-hero-agreement span {\n  opacity: 0.6;\n}\n\n.docs-home-hero-link {\n  color: #00B67A;\n  text-decoration: underline;\n}\n\nhtml.dark .docs-home-hero-link {\n  color: #00DD94;\n}\n\n.docs-home-content {\n  max-width: 70rem;\n  margin: 4rem auto 8rem;\n  padding: 0 1.25rem;\n}\n\n.docs-home-section-title {\n  margin-top: 3.25rem;\n  margin-bottom: 1.25rem;\n  font-size: 1.75rem;\n  font-weight: 650;\n  line-height: 2.25rem;\n}\n\n.docs-home-section-title:first-child {\n  margin-top: 0;\n}\n"])</script><script>self.__next_f.push([1,"60:[[\"$\",\"style\",\"0\",{\"data-custom-css-index\":0,\"data-custom-css-path\":\"style.css\",\"dangerouslySetInnerHTML\":{\"__html\":\"$65\"}}]]\n61:[\"$\",\"$L66\",null,{\"customJsDisabled\":false,\"jsFiles\":[]}]\n"])</script><script>self.__next_f.push([1,"62:[\"$\",\"$L67\",null,{\"slug\":\"websockets/orderbook-updates\",\"pageMetadata\":\"$54:props:pageMetadata\",\"theme\":\"mint\",\"children\":[\"$\",\"$L68\",null,{\"mdxSource\":{\"compiledSource\":\"\\\"use strict\\\";const{Fragment:_Fragment,jsx:_jsx}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props