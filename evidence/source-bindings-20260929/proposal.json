{
  "benefit": "actual first-half keys/outcomes/line orientations/links/source IDs and per-book presence for one NFL event; raw period pairs if both comparison books return identical outcomes/lines",
  "discovery": {
    "endpoint": "/v4/sports/americanfootball_nfl/events",
    "maximum_credits": 0,
    "maximum_requests": 1,
    "params": {
      "dateFormat": "iso"
    },
    "selection": "earliest future commence_time within seven days of discovery receipt; event ID ascending tie-break; validate sport, distinct participants, unique IDs"
  },
  "does_not_unlock": [
    "settlement equivalence",
    "execution/depth/fees",
    "native event qualification",
    "other 42 period/futures cells",
    "six-sport availability",
    "beta signoff"
  ],
  "event_odds": {
    "authorized": false,
    "endpoint": "/v4/sports/americanfootball_nfl/events/SELECTEDDISCOVERYEVENTID/odds",
    "maximum_credits": 3,
    "maximum_requests_including_discovery": 2,
    "params": {
      "bookmakers": "novig,prophetx,pinnacle,draftkings,betmgm",
      "dateFormat": "iso",
      "includeBetLimits": "true",
      "includeLinks": "true",
      "includeSids": "true",
      "markets": "h2h_h1,spreads_h1,totals_h1",
      "oddsFormat": "decimal"
    }
  },
  "historical_requests": 0,
  "limits": {
    "body_bytes_per_response": 2097152,
    "timeout_seconds_per_request": 20,
    "total_body_bytes": 4194304,
    "wall_seconds": 45
  },
  "market_discovery_requests": 0,
  "maximum_credits": 3,
  "maximum_requests": 2,
  "previous_acquisition": "consumed",
  "purchases": 0,
  "quota": "current remaining header from discovery must be present and >=3; recorded 484 is not a gate input",
  "retries": 0,
  "status": "PREPARED_NOT_AUTHORIZED",
  "stop": [
    "no eligible event",
    "invalid discovery or ambiguous IDs",
    "quota missing, malformed or <3",
    "event started before odds dispatch",
    "any HTTP error, redirect, timeout, schema failure or body cap",
    "first odds response whether populated, partial or empty"
  ]
}
