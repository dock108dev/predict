#!/bin/sh
# Dedicated socket-only PostgreSQL; no login service and no TCP listener.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
DATA="$ROOT/.local/postgres"
SOCKET="$ROOT/.local/pgsocket"
PORT=55432
case "${1:-}" in
 start)
  mkdir -p "$SOCKET"
  chmod 700 "$ROOT/.local" "$SOCKET"
  if [ ! -f "$DATA/PG_VERSION" ]; then
   initdb -D "$DATA" -U prediction_arb --auth-local=trust --auth-host=reject --encoding=UTF8 --no-locale >/dev/null
  fi
  if ! pg_ctl -D "$DATA" status >/dev/null 2>&1; then
   pg_ctl -D "$DATA" -l "$ROOT/.local/postgres.log" -o "-k '$SOCKET' -p $PORT -c listen_addresses='' -c unix_socket_permissions=0700" start
  fi
  if ! psql -h "$SOCKET" -p "$PORT" -U prediction_arb -d postgres -Atc "SELECT 1 FROM pg_database WHERE datname='prediction_arb'" | rg -q 1; then
   createdb -h "$SOCKET" -p "$PORT" -U prediction_arb prediction_arb
  fi
  ;;
 stop) pg_ctl -D "$DATA" -m fast stop ;;
 status) pg_ctl -D "$DATA" status ;;
 *) echo 'Usage: scripts/project-postgres start|stop|status'; exit 2 ;;
esac
