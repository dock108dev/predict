(predict_backend) {
	reverse_proxy 127.0.0.1:8784 {
		header_up Host 127.0.0.1:8784
		header_up -Authorization
	}
}

(predict_admin) {
	basicauth {
		import /etc/caddy/predict-auth
	}
	import predict_backend
}

predict.dock108.dev {
	@publicRead {
		method GET HEAD
		path / /ev /arbs /browse-odds /game /replay /view/current/desk.html /api/comparison-current /api/comparison-current/updates /api/comparison-current/selection /api/comparison-snapshot/details /api/odds-replay /api/odds-replay/details
	}
	@publicAssets {
		method GET HEAD
		path_regexp predictAssets ^/view/current/[a-z0-9-]+\.(css|js|ttf|png)$
	}
	@publicLease {
		method POST DELETE
		path /api/comparison-current/lease
	}
	@admin path /admin /admin/* /raw-odds /odds /coverage /current/coverage /scanner /api/* /current/assets/* /view/* /style.css /shared-state.js
	@browserIcon {
		method GET HEAD
		path /favicon.ico /apple-touch-icon.png /apple-touch-icon-precomposed.png
	}
	@foreignOrigin {
		header Origin *
		not header Origin https://predict.dock108.dev
	}
	@predictOrigin header Origin https://predict.dock108.dev

	route {
		respond @foreignOrigin 403
		redir @browserIcon /view/current/predict-icon.png 302
		request_header @predictOrigin Origin http://127.0.0.1:8784
		handle @publicRead {
			import predict_backend
		}
		handle @publicAssets {
			import predict_backend
		}
		handle @publicLease {
			import predict_backend
		}
		handle @admin {
			import predict_admin
		}
		respond 404
	}
}
